<%- include('../partials/top') %>
<% const budgets = ['Cần tư vấn', 'Dưới 500.000₫', '500.000₫ – 1.000.000₫', '1.000.000₫ – 2.000.000₫', '2.000.000₫ – 5.000.000₫', 'Trên 5.000.000₫']; %>
<section class="hero hero-about">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">Quà Tết doanh nghiệp</span>
      <h1 class="display hero-title" style="margin-top:20px"><span class="line">Món quà mang</span> <span class="line"><em>dấu ấn</em> thương hiệu</span></h1>
      <p class="lead lead-full">Lunar Lucky thiết kế giỏ quà Tết theo ngân sách và tinh thần doanh nghiệp: in logo doanh nghiệp, xuất hóa đơn VAT, giao hàng loạt đúng hẹn đến từng đối tác trên toàn quốc.</p>
      <div class="hero-cta"><a class="btn btn-lg" href="#bao-gia">Nhận báo giá trong 24h</a><a class="btn btn-ghost btn-lg" href="tel:<%= s.shop_phone.replace(/s/g,'') %>"><svg class="icon"><use href="#i-phone"/></svg> <%= s.shop_phone %></a></div>
    </div>
    <div class="hero-visual hero-photo">
      <div class="photo"><picture><source media="(min-width: 1360px)" srcset="/img/b2b-hero-wide-2000.webp" width="2000" height="750"><img src="/img/b2b-hero-crop-1040.webp" alt="Hai đối tác doanh nghiệp trao nhau giỏ quà Tết Lunar Lucky trong văn phòng" width="1060" height="750" fetchpriority="high"></picture></div>
    </div>
  </div>
</section>
<section class="section quote-section" id="bao-gia" style="background:var(--cream-50)">
  <div class="container split" style="align-items:start">
    <div>
      <span class="eyebrow">Yêu cầu báo giá</span>
      <h2 class="h2" style="margin-top:16px">Nhận báo giá <em>quà Tết doanh nghiệp</em></h2>
      <p class="lead" style="margin-top:20px">Chia sẻ số lượng và ngân sách dự kiến, Lunar Lucky sẽ tư vấn mẫu quà phù hợp và phản hồi trong vòng 24 giờ làm việc.</p>
      <ul class="feature-list" style="margin-top:32px">
        <li><span class="feature-ico"><svg class="icon"><use href="#i-sparkle"/></svg></span><div><strong>Tùy chỉnh logo</strong><span>Tư vấn vị trí in logo theo mẫu quà và số lượng.</span></div></li>
        <li><span class="feature-ico"><svg class="icon"><use href="#i-file"/></svg></span><div><strong>Hóa đơn &amp; chứng từ</strong><span>Hỗ trợ hóa đơn VAT, hợp đồng và biên bản giao nhận theo yêu cầu.</span></div></li>
        <li><span class="feature-ico"><svg class="icon"><use href="#i-truck"/></svg></span><div><strong>Giao nhiều địa chỉ</strong><span>Sắp xếp giao quà theo danh sách người nhận.</span></div></li>
      </ul>
    </div>
    <div class="card">
      <% if (sent) { %>
        <div style="text-align:center;padding:24px 0" role="status">
          <div class="order-hero" style="padding:0"><div class="seal"><svg class="icon"><use href="#i-check"/></svg></div></div>
          <h3 class="h3">Lunar Lucky đã nhận yêu cầu</h3>
          <p class="muted" style="margin-top:8px">Chuyên viên sẽ liên hệ bạn trong vòng 24 giờ làm việc. Cảm ơn bạn đã tin chọn Lunar Lucky.</p>
          <p class="small muted" style="margin-top:12px">Đã có danh sách người nhận (Excel) hoặc file logo? Gửi luôn qua Zalo để báo giá sát hơn.</p>
          <div class="hero-cta" style="justify-content:center;margin-top:16px"><a class="btn" href="<%= s.zalo_url %>" target="_blank" rel="noopener">Gửi qua Zalo</a><a class="btn btn-quiet" href="tel:<%= s.shop_phone.replace(/\s/g,'') %>">Cần gấp? Gọi <%= s.shop_phone %></a></div>
        </div>
      <% } else { %>
      <% const moreOpen = !!(errors.email || errors.delivery_date || errors.message || values.email || values.delivery_date || values.logo_print || values.message); %>
      <form action="/qua-tang-doanh-nghiep#bao-gia" method="post" data-quote-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div style="position:absolute;left:-9999px" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
        <p class="small muted" style="margin:0 0 16px">Chỉ các mục có dấu <span style="color:#c62828;font-weight:700">*</span> là bắt buộc.</p>
        <div class="grid-2">
          <%- include('../partials/field', { name: 'contact_name', label: 'Người liên hệ', required: true, autocomplete: 'name' }) %>
          <%- include('../partials/field', { name: 'phone', label: 'Số điện thoại', type: 'tel', required: true, autocomplete: 'tel', inputmode: 'tel' }) %>
        </div>
        <div class="grid-2" style="margin-top:16px;align-items:end">
          <%- include('../partials/field', { name: 'quantity', label: 'Số lượng dự kiến', type: 'number', min: 5, inputmode: 'numeric', placeholder: 'VD: 50' }) %>
          <%- include('../partials/field', { name: 'budget', label: 'Ngân sách mỗi giỏ', as: 'select', options: budgets }) %>
        </div>
        <div style="margin-top:16px"><%- include('../partials/field', { name: 'company', label: 'Tên doanh nghiệp', optional: true, autocomplete: 'organization' }) %></div>
        <details class="more-note quote-more" <%= moreOpen ? 'open' : '' %> style="margin-top:20px">
          <summary>Bổ sung yêu cầu chi tiết</summary>
          <div style="margin-top:16px"><%- include('../partials/field', { name: 'email', label: 'Email công việc', type: 'email', optional: true, autocomplete: 'email' }) %></div>
          <div style="margin-top:16px"><%- include('../partials/field', { name: 'delivery_date', label: 'Ngày cần giao', type: 'date', optional: true }) %></div>
          <label class="check"><input type="checkbox" name="logo_print" value="1" <%= values.logo_print ? 'checked' : '' %>> Tôi muốn in logo doanh nghiệp</label>
          <div style="margin-top:12px"><%- include('../partials/field', { name: 'message', label: 'Mô tả thêm', as: 'textarea', optional: true, maxlength: 2000, placeholder: 'Đối tượng nhận quà, phong cách mong muốn, yêu cầu đặc biệt…' }) %></div>
        </details>
        <button class="btn btn-lg btn-block" type="submit" style="margin-top:24px" data-quote-submit>Gửi yêu cầu báo giá</button>
        <p class="small muted" style="margin-top:12px;text-align:center">Gửi yêu cầu không đồng nghĩa với đặt hàng hoặc thanh toán.</p>
        <p class="small" style="margin-top:6px;text-align:center"><a href="<%= s.zalo_url %>" target="_blank" rel="noopener" style="color:var(--primary);font-weight:600;text-decoration:underline">Cần trao đổi ngay? Tư vấn qua Zalo</a></p>
      </form>
      <% } %>
    </div>
  </div>
</section>

<section class="section milestones-section">
  <div class="ms-bg" aria-hidden="true"><img src="/img/b2b-so-luong-1600.webp" alt="" width="1600" height="900" loading="lazy" decoding="async"></div>
  <div class="container">
    <div class="section-head center"><span class="eyebrow center">Theo từng mốc số lượng</span><h2 class="h2">Đặt quà <em>theo số lượng</em></h2><p class="lead" style="margin-top:12px">Tham khảo thời gian chuẩn bị và các lựa chọn tùy chỉnh cho doanh nghiệp.</p></div>
    <% const tierAt = (n) => bulkTierList().filter((b) => b.tier.qty <= n).pop();
       const stops = [
         { n: 10, custom: 'In logo doanh nghiệp.' },
         { n: 30, custom: 'In logo doanh nghiệp.' },
         { n: 50, custom: 'In logo doanh nghiệp.' },
         { n: 100, custom: 'In logo lên hộp và nơ; chuyên viên riêng phụ trách đơn.' },
       ]; %>
    <p class="milestone-common">Tư vấn theo ngân sách · Tùy chỉnh logo · Giao nhiều địa chỉ</p>
    <p class="milestone-label">Các mốc số lượng tham khảo</p>
    <ul class="milestones">
      <% stops.forEach((m) => { const t = tierAt(m.n); %>
      <li>
        <div class="qty-range"><%= m.n %> giỏ</div>
        <dl>
          <dt>Thời gian chuẩn bị</dt><dd><%= t && t.tier.kind === 'review' ? 'Theo lịch thống nhất trong báo giá.' : (t ? 'Dự kiến ' + t.text.replace(/^cần\s+/, '').replace(/\s*chuẩn bị.*$/, '') : '') %></dd>
          <dt>Tùy chỉnh</dt><dd><%= m.custom %></dd>
        </dl>
      </li>
      <% }) %>
    </ul>
    <p class="milestone-foot small muted">Thời gian dự kiến tính từ khi duyệt mẫu và hoàn tất đặt cọc; chưa gồm thời gian vận chuyển. Lịch cụ thể được xác nhận trong báo giá. Từ 500 giỏ có thể thiết kế hộp riêng theo nhận diện thương hiệu.</p>
    <div class="milestone-notes">
      <div><h3>Chi phí rõ ràng</h3><p>Báo giá tách rõ tiền quà, tùy chỉnh logo, vận chuyển và VAT nếu áp dụng. Hỗ trợ xuất hóa đơn theo thông tin doanh nghiệp cung cấp.</p></div>
      <div><h3>Duyệt mẫu trước khi làm</h3><p>Thống nhất mẫu giỏ, thiết kế logo và báo giá trước khi triển khai.</p></div>
      <div><h3>Đặt cọc &amp; thanh toán</h3><p>Mức cọc, thời điểm thanh toán phần còn lại và điều kiện áp dụng được ghi rõ trong báo giá.</p></div>
    </div>
    <div style="text-align:center;margin-top:var(--space-6)"><a class="btn btn-lg" href="#bao-gia">Nhận báo giá theo số lượng</a></div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head center"><span class="eyebrow center">Quy trình</span><h2 class="h2">Bốn bước, <em>không phải lo nghĩ</em></h2></div>
    <ol class="journey journey-4">
      <li><h3>Tư vấn</h3><p>Lắng nghe nhu cầu, tư vấn quà tặng phù hợp với ngân sách và người nhận.</p></li>
      <li><h3>Duyệt mẫu</h3><p>Thống nhất mẫu quà, thiết kế logo và báo giá trước khi thực hiện.</p></li>
      <li><h3>Đóng gói</h3><p>Chuẩn bị, kiểm tra và hoàn thiện từng phần quà theo mẫu đã duyệt.</p></li>
      <li><h3>Giao quà tận nơi</h3><p>Giao theo danh sách, cập nhật tiến độ và xác nhận từng đơn hàng.</p></li>
    </ol>
  </div>
</section>

<% if (products.length) { %>
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="section-head"><div class="stack"><span class="eyebrow">Mẫu tham khảo</span><h2 class="h2">Được doanh nghiệp <em>lựa chọn</em></h2></div><a class="link-arrow" href="/bo-suu-tap">Xem toàn bộ <svg class="icon icon-sm"><use href="#i-arrow"/></svg></a></div>
    <div class="product-grid cols-4"><% products.forEach((p, i) => { %><%- include('../partials/product-card', { p, i }) %><% }) %></div>
  </div>
</section>
<% } %>
<%- include('../partials/bottom') %>
