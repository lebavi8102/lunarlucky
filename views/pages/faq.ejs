<%- include('../partials/top') %>
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Hỗ trợ</span>
    <h1>Câu hỏi thường gặp</h1>
    <p class="lead">Chưa tìm thấy câu trả lời? Nhắn Lunar qua <a href="<%= s.zalo_url %>" target="_blank" rel="noopener" style="color:var(--primary);font-weight:600">Zalo</a> hoặc gọi <a href="tel:<%= s.shop_phone.replace(/\s/g,'') %>" style="color:var(--primary);font-weight:600"><%= s.shop_phone %></a>.</p>
  </div>
</section>
<section class="section-tight">
  <div class="container faq">
    <% faqs.forEach((f, i) => { %>
    <details <%= i === 0 ? 'open' : '' %>>
      <summary><%= f.q %><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></summary>
      <p><%= f.a %></p>
    </details>
    <% }) %>
  </div>
</section>
<%- include('../partials/bottom') %>
