<%- include('_top') %>
<% const on = rows.filter(r => r.active); const off = rows.filter(r => !r.active); const pct = Math.min(100, Math.round(used / max * 100)); %>
<div class="admin-head"><h1>Kho tri thức AI</h1><span class="muted small"><%= on.length %> mục đang áp dụng · <%= used.toLocaleString('vi-VN') %>/<%= max.toLocaleString('vi-VN') %> ký tự (<%= pct %>%)</span></div>
<p class="small muted" style="margin:-8px 0 16px">Viết ở đây những điều AI cần biết để trả lời khách: chính sách giao hàng, đổi trả, thanh toán, quy trình, câu hỏi thường gặp. AI dùng nội dung mục đang bật ngay từ tin nhắn tiếp theo. <b>Đừng ghi giá bán, tồn kho hay tình trạng đơn</b> — AI luôn lấy những thứ đó từ dữ liệu thật của website. Chuyện hóa đơn VAT chỉ mời khách nhắn Zalo.</p>

<form class="panel" action="/admin/kien-thuc" method="post" style="margin-bottom:20px">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label class="label" for="kt">Tiêu đề</label>
  <input class="input" id="kt" name="title" maxlength="<%= limits.title %>" placeholder="vd: Giao hàng ngày 28–29 Chạp">
  <label class="label" for="kc" style="margin-top:10px">Nội dung (tối đa <%= limits.content %> ký tự)</label>
  <textarea class="textarea" id="kc" name="content" maxlength="<%= limits.content %>" rows="4" placeholder="vd: Đơn đặt đến hết 29 tháng Chạp vẫn giao được trong nội thành Hà Nội nếu khách chọn buổi sáng. Ngoài Hà Nội cần đặt trước ít nhất 3 ngày."></textarea>
  <button class="btn btn-sm" type="submit" style="margin-top:8px">Thêm vào kho</button>
</form>

<% [...on, ...off].forEach(r => { %>
<form class="panel" action="/admin/kien-thuc/<%= r.id %>" method="post" style="margin-bottom:12px<%= r.active ? '' : ';opacity:.7' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div style="display:flex;gap:8px;align-items:center;margin-bottom:6px">
    <span class="status <%= r.active ? 'status-completed' : 'status-pending' %>"><%= r.active ? 'Đang áp dụng' : 'Đã tắt' %></span>
    <span class="tiny muted">Cập nhật <%= fmt.dateTime(r.updated_at) %></span>
  </div>
  <input class="input" name="title" maxlength="<%= limits.title %>" value="<%= r.title %>" aria-label="Tiêu đề">
  <textarea class="textarea" name="content" maxlength="<%= limits.content %>" rows="4" style="margin-top:8px" aria-label="Nội dung"><%= r.content %></textarea>
  <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
    <button class="btn btn-sm" type="submit" name="action" value="save">Lưu sửa</button>
    <% if (r.active) { %><button class="btn btn-sm btn-quiet" type="submit" name="action" value="off">Ngừng áp dụng</button>
    <% } else { %><button class="btn btn-sm btn-quiet" type="submit" name="action" value="on">Bật lại</button><% } %>
  </div>
</form>
<form action="/admin/kien-thuc/<%= r.id %>" method="post" data-confirm="Xóa mục này khỏi kho tri thức? Thao tác không thể hoàn tác." style="margin:-4px 0 12px">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="action" value="delete">
  <button class="btn btn-sm btn-quiet" type="submit">Xóa mục này</button>
</form>
<% }) %>
<% if (!rows.length) { %><div class="panel"><p class="muted">Kho đang trống. Thêm mục đầu tiên ở ô phía trên — ví dụ chính sách giao hàng ngày cận Tết, cách đổi trả khi hàng hỏng, hoặc câu trả lời cho câu hỏi khách hay hỏi.</p></div><% } %>
<%- include('_bottom') %>
