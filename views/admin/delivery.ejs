<%- include('_top') %>
<% const d = plan; const label = (x) => x.slice(8) + '/' + x.slice(5, 7) + '/' + x.slice(0, 4); %>
<div class="admin-head">
  <h1>Giao hàng ngày <%= label(d.day) %></h1>
  <div class="actions">
    <a class="btn btn-sm" href="/admin/giao-hang/in?ngay=<%= d.day %>" target="_blank" rel="noopener"><svg class="icon icon-sm"><use href="#i-printer"/></svg> In tất cả phiếu giao</a>
    <a class="btn btn-sm btn-quiet" href="/admin/giao-hang/excel?ngay=<%= d.day %>"><svg class="icon icon-sm"><use href="#i-cloud"/></svg> Excel danh sách giao</a>
  </div>
</div>

<form class="list-tools" method="get" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
  <% quick.forEach(([day, text]) => { %><a class="chip" href="?ngay=<%= day %>" aria-current="<%= day === d.day %>"><%= text %></a><% }) %>
  <label class="sr-only" for="ngay">Chọn ngày</label>
  <input class="input" type="date" id="ngay" name="ngay" value="<%= d.day %>" style="width:auto" onchange="this.form.submit()">
</form>

<div class="stat-grid">
  <div class="stat hl"><div class="label">Đơn cần giao</div><div class="value"><%= d.ready.length %></div><div class="small" style="opacity:.8">Hà Nội <%= d.hanoi %> · tỉnh <%= d.provinces %></div></div>
  <div class="stat"><div class="label">Tổng số giỏ</div><div class="value"><%= d.baskets %></div></div>
  <div class="stat"><div class="label">Thiệp cần viết</div><div class="value"><%= d.cards %></div></div>
  <div class="stat"><div class="label">Tiền COD cần thu</div><div class="value"><%= money(d.codTotal) %></div></div>
</div>

<% if (d.unpaid.length) { %>
<div class="flash flash-error" role="alert" style="margin:16px 0"><svg class="icon"><use href="#i-alert"/></svg><span><b><%= d.unpaid.length %> đơn chuyển khoản chưa thanh toán</b> có ngày giao này — <b>chưa soạn, chưa giao</b>: <% d.unpaid.forEach((o, i) => { %><a href="/admin/don-hang/<%= o.id %>" style="text-decoration:underline"><%= o.code %></a><%= i < d.unpaid.length - 1 ? ', ' : '' %><% }) %>.</span></div>
<% } %>

<div class="panel-grid" style="margin-top:20px">
  <section class="panel">
    <h2>Bảng soạn hàng</h2>
    <% if (!d.picking.length) { %><p class="muted small">Không có đơn cần giao ngày này.</p><% } else { %>
    <table class="table"><thead><tr><th scope="col">Giỏ quà</th><th scope="col" class="num">Số giỏ</th><th scope="col" class="num">Số đơn</th></tr></thead><tbody>
      <% d.picking.forEach(p => { %><tr><td class="wrap"><%= p.name %><% if (p.sku) { %> <span class="small muted"><%= p.sku %></span><% } %></td><td class="num"><b><%= p.qty %></b></td><td class="num"><%= p.orders %></td></tr><% }) %>
    </tbody></table>
    <% } %>
  </section>
  <section class="panel">
    <h2>Thiệp cần viết</h2>
    <% const cards = d.ready.filter(o => o.card_message); %>
    <% if (!cards.length) { %><p class="muted small">Không có lời chúc nào.</p><% } else { %>
    <ol class="small" style="padding-left:18px;display:grid;gap:10px">
      <% cards.forEach(o => { %><li><b><%= o.code %></b>: “<%= o.card_message %>”</li><% }) %>
    </ol>
    <% } %>
  </section>
</div>

<section class="panel" style="margin-top:20px">
  <h2>Danh sách giao</h2>
  <div class="table-wrap" style="border:0">
    <table class="table">
      <thead><tr><th scope="col">Mã đơn</th><th scope="col">Giao cho</th><th scope="col">Địa chỉ</th><th scope="col">Giỏ</th><th scope="col" class="num">Thu COD</th><th scope="col">Trạng thái</th></tr></thead>
      <tbody>
      <% if (!d.ready.length) { %><tr><td colspan="6" class="muted" style="padding:24px;text-align:center">Chưa có đơn.</td></tr><% } %>
      <% d.ready.forEach(o => { const t = shipTo(o); %>
        <tr>
          <td><a class="t" href="/admin/don-hang/<%= o.id %>"><%= o.code %></a><% if (o.delivery_slot) { %><br><b class="tiny">⏰ <%= fmt.slotLabel(o.delivery_slot) %></b><% } %><% if (o.is_gift) { %><br><span class="tiny" style="color:var(--gold-700)">🎁 gửi tặng</span><% } %></td>
          <td><%= t.name %><br><a class="tiny" href="tel:<%= t.phone %>"><%= t.phone %></a></td>
          <td class="wrap small"><%= t.address %><br><span class="tiny muted"><%= d.area(o) %></span></td>
          <td class="wrap small"><%= o.items.map(i => i.name + ' × ' + i.qty).join(', ') %></td>
          <td class="num"><%= codDue(o) ? money(codDue(o)) : '—' %></td>
          <td><span class="status status-<%= o.status %>"><%= ORDER_STATUS[o.status] %></span></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('_bottom') %>
