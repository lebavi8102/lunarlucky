<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <title>Phiếu <%= order.code %></title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600&family=Cormorant+Garamond:ital,wght@0,600;1,500&display=swap&subset=vietnamese">
  <link rel="stylesheet" href="/css/print.css">
  <script src="/js/print.js" defer></script>
</head>
<body>
  <section class="slip">
    <header><div class="brand">LUNAR LUCKY<small>LUXURY GIFTS &amp; HAMPERS</small></div><div><b><%= order.code %></b><br>Giao ngày <%= fmt.ymd(order.delivery_date) %></div></header>
    <div class="cols">
      <div><h3>Người nhận</h3>
        <% if (order.is_gift) { %><p><b><%= order.recipient_name %></b><br><%= order.recipient_phone %><br><%= order.recipient_address %>, <%= order.province %></p>
        <% } else { %><p><b><%= order.customer_name %></b><br><%= order.phone %><br><%= order.address %>, <%= order.province %></p><% } %>
      </div>
      <div><h3>Thu hộ (COD)</h3><p class="cod"><%= order.payment_method === 'cod' && order.payment_status !== 'paid' ? money(order.total) : '0₫ — đã thanh toán' %></p>
        <% if (order.is_gift) { %><p class="note">Đơn gửi tặng: không đưa hóa đơn giá tiền cho người nhận.</p><% } %>
      </div>
    </div>
    <h3>Danh sách đóng gói</h3>
    <table>
      <% items.forEach(i => { %>
        <tr><td><input type="checkbox" aria-label="Đã xếp"> <b><%= i.name %></b> × <%= i.qty %></td></tr>
      <% }) %>
    </table>
    <% if (order.note) { %><p class="note"><b>Ghi chú:</b> <%= order.note %></p><% } %>
  </section>

  <% if (order.card_message) { %>
  <section class="card-print">
    <div class="ornament">✦</div>
    <p class="msg"><%= order.card_message %></p>
  </section>
  <% } %>
</body>
</html>
