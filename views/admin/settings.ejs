<%- include('_top') %>
<div class="admin-head"><h1>Cài đặt</h1></div>
<section class="form-card" style="margin-bottom:24px">
  <h2>Email gửi khách</h2>
  <% if (mailReady) { %>
    <p class="small">✅ Đã cài email. Thư gửi từ: <b><%= mailFrom %></b></p>
  <% } else { %>
    <p class="small">⚠️ Chưa cài email — khách sẽ không nhận được thư xác nhận đơn. Cần thêm SMTP_HOST, SMTP_USER, SMTP_PASS trên Render.</p>
  <% } %>
  <form action="/admin/email-thu" method="post" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field" style="flex:1;min-width:220px;margin:0"><label class="label" for="mail-to">Gửi email thử tới</label><input class="input" id="mail-to" name="to" type="email" value="<%= user.email %>"></div>
    <button class="btn btn-sm" type="submit">Gửi email thử</button>
  </form>
</section>
<form action="/admin/cai-dat" method="post" class="form-grid">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div>
    <datalist id="bank-codes"><% banks.forEach(([code, name]) => { %><option value="<%= code %>"><%= name %></option><% }) %></datalist>
    <% groups.forEach(([title, fields, extra]) => { %>
    <section class="form-card">
      <h2><%= title %></h2>
      <% fields.forEach(([k, label, kind]) => { %>
        <div class="field">
          <label class="label" for="s-<%= k %>"><%= label %></label>
          <% if (kind === 'textarea') { %><textarea class="textarea" id="s-<%= k %>" name="<%= k %>"><%= values[k] %></textarea>
          <% } else if (kind === 'bank') { %><input class="input" id="s-<%= k %>" name="<%= k %>" value="<%= values[k] %>" list="bank-codes" placeholder="Chọn hoặc gõ mã, VD: VCB" autocomplete="off"><p class="help">Mã ngân hàng theo VietQR: VCB, BIDV, ICB (VietinBank), VBA (Agribank), TCB, MB, ACB…</p>
          <% } else { %><input class="input" id="s-<%= k %>" name="<%= k %>" value="<%= values[k] %>"><% } %>
        </div>
      <% }) %>
      <% if (extra && extra.startsWith('qr:')) { const pre = extra.slice(3); %>
        <% if (values[pre + '_id'] && values[pre + '_account']) { %>
          <p class="help" style="margin-top:12px">Mã QR thử với 100.000₫ (quét bằng app ngân hàng để kiểm tra đúng tên chủ tài khoản, không cần chuyển):</p>
          <img src="https://img.vietqr.io/image/<%= encodeURIComponent(values[pre + '_id']) %>-<%= encodeURIComponent(values[pre + '_account']) %>-compact2.png?amount=100000&addInfo=TEST&accountName=<%= encodeURIComponent(values[pre + '_holder']) %>" alt="Mã VietQR thử" width="180" style="margin-top:8px;border:1px solid var(--line);border-radius:8px" loading="lazy">
        <% } else { %>
          <p class="help" style="margin-top:12px">Chưa đủ thông tin<%= pre === 'company_bank' ? ' — đơn xuất VAT sẽ chưa hiện mã QR, khách được báo nhân viên gửi thông tin chuyển khoản' : '' %>.</p>
        <% } %>
      <% } %>
    </section>
    <% }) %>
  </div>
  <aside class="form-side">
    <div class="form-card">
      <button class="btn btn-block" type="submit">Lưu cài đặt</button>
      <p class="tiny muted" style="margin-top:10px">Thay đổi áp dụng cho toàn bộ website trong vòng 30 giây.</p>
    </div>
  </aside>
</form>
<%- include('_bottom') %>
