<%- include('_top') %>
<% const max = Math.max(1, ...days.map(d => d.total)); const today = days[days.length - 1].day; %>
<div class="admin-head"><h1>Tổng quan</h1><div class="actions"><a class="btn btn-sm btn-quiet" href="/bo-suu-tap" target="_blank" rel="noopener"><svg class="icon icon-sm"><use href="#i-plus"/></svg> Đặt hộ khách</a> <a class="btn btn-sm" href="/admin/san-pham/moi"><svg class="icon icon-sm"><use href="#i-plus"/></svg> Thêm sản phẩm</a></div></div>

<div class="stat-grid">
  <div class="stat hl"><div class="label">Doanh thu hôm nay</div><div class="value"><%= money(stats.revenueToday) %></div><div class="small" style="opacity:.75"><%= stats.ordersToday %> đơn<% if (stats.waitingToday) { %> · chờ tiền <%= money(stats.waitingToday) %><% } %></div></div>
  <div class="stat"><div class="label">Doanh thu tháng này</div><div class="value"><%= money(stats.revenueMonth) %></div></div>
  <div class="stat"><div class="label">Đơn mới cần xử lý</div><a class="value" href="/admin/don-hang?can_xu_ly=1" style="display:block"><%= stats.newOrders %></a></div>
  <div class="stat"><div class="label">Chờ chuyển khoản / cọc</div><a class="value" href="/admin/don-hang?chua_tt=1" style="display:block"><%= stats.unpaidBank %></a></div>
  <div class="stat"><div class="label">Báo giá B2B mới</div><a class="value" href="/admin/bao-gia" style="display:block"><%= stats.newQuotes %></a></div>
</div>

<div class="panel-grid">
  <section class="panel">
    <h2>Doanh thu 14 ngày qua <span class="small muted" style="font-weight:400">Không tính đơn đã hủy hoặc đang chờ chuyển khoản/cọc</span></h2>
    <div class="chart" role="list" aria-label="Doanh thu theo ngày">
      <% days.forEach(d => { %>
        <div class="bar <%= d.day === today ? 'today' : '' %>" role="listitem" tabindex="0" style="height:<%= Math.max(1, Math.round(d.total / max * 100)) %>%" aria-label="<%= fmt.ymd(d.day) %>: <%= money(d.total) %>, <%= d.count %> đơn">
          <span class="tip"><%= fmt.ymd(d.day).slice(0, 5) %> · <%= money(d.total) %> · <%= d.count %> đơn</span>
        </div>
      <% }) %>
    </div>
    <div class="chart-x" aria-hidden="true"><% days.forEach(d => { %><span><%= d.day.slice(8) %></span><% }) %></div>
  </section>
  <section class="panel">
    <h2>Sắp hết hàng <a href="/admin/san-pham">Tất cả</a></h2>
    <% if (!lowStock.length) { %><p class="muted small">Tồn kho đều ổn.</p><% } else { %>
    <table class="table"><tbody>
      <% lowStock.forEach(p => { %><tr><td class="wrap"><a class="t" href="/admin/san-pham/<%= p.id %>"><%= p.name %></a></td><td class="num"><span class="status <%= p.stock <= 0 ? 'status-cancelled' : 'status-pending' %>"><%= p.stock %> còn</span></td></tr><% }) %>
    </tbody></table>
    <% } %>
  </section>
</div>

<div class="panel-grid" style="margin-top:20px">
  <section class="panel">
    <h2>Đơn gần đây <a href="/admin/don-hang">Xem tất cả</a></h2>
    <div class="table-wrap" style="border:0">
      <table class="table">
        <thead><tr><th scope="col">Mã</th><th scope="col">Khách</th><th scope="col">Giao</th><th scope="col">Trạng thái</th><th scope="col" class="num">Tổng</th></tr></thead>
        <tbody>
        <% if (!recent.length) { %><tr><td colspan="5" class="muted">Chưa có đơn hàng.</td></tr><% } %>
        <% recent.forEach(o => { %>
          <tr>
            <td><a class="t" href="/admin/don-hang/<%= o.id %>"><%= o.code %></a></td>
            <td><%= o.customer_name %></td>
            <td><%= fmt.ymd(o.delivery_date) %></td>
            <td><span class="status status-<%= o.status %>"><%= ORDER_STATUS[o.status] %></span></td>
            <td class="num"><%= money(o.total) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </section>
  <section class="panel">
    <h2>Bán chạy</h2>
    <table class="table"><tbody>
      <% topProducts.forEach(p => { %><tr><td class="wrap"><a class="t" href="/admin/san-pham/<%= p.id %>"><%= p.name %></a></td><td class="num"><%= p.sold %> đã bán</td></tr><% }) %>
    </tbody></table>
  </section>
</div>

<div class="panel-grid" style="margin-top:24px">
  <section class="panel">
    <div class="panel-head"><h2>Đơn theo kênh · 32 ngày</h2></div>
    <% const ch = Object.entries(byChannel).sort((a, b) => b[1].total - a[1].total); %>
    <% if (!ch.length) { %><p class="muted small">Chưa có đơn.</p><% } else { %>
    <table class="table"><tbody>
      <% ch.forEach(([k, c]) => { %><tr><td><a class="t" href="/admin/don-hang?nguon=<%= k %>"><%= fmt.sourceLabel(k) %></a></td><td class="num"><%= c.n %> đơn</td><td class="num"><b><%= money(c.total) %></b></td></tr><% }) %>
    </tbody></table>
    <% } %>
    <p class="tiny muted" style="margin-top:8px">Không tính đơn hủy / chờ tiền. "Website" = khách tự vào web không rõ nguồn.</p>
  </section>
  <section class="panel">
    <div class="panel-head"><h2>Nút "Mua ngay" và "Thêm vào giỏ" · 32 ngày</h2></div>
    <% const ctaRows = [['buy_now', 'Mua ngay'], ['add_to_cart', 'Thêm vào giỏ']].filter(([k]) => byCta[k]); %>
    <% if (!ctaRows.length) { %><p class="muted small">Chưa có đơn nào ghi nhận nút bấm (chỉ tính đơn khách tự đặt từ lúc bật tính năng).</p><% } else { %>
    <table class="table"><thead><tr><th></th><th class="num">Đơn đã chốt</th><th class="num">Giao thành công</th><th class="num">Tỷ lệ</th></tr></thead><tbody>
      <% ctaRows.forEach(([k, label]) => { const c = byCta[k]; %><tr><td><%= label %></td><td class="num"><%= c.n %></td><td class="num"><b><%= c.done %></b></td><td class="num"><%= Math.round((c.done / c.n) * 100) %>%</td></tr><% }) %>
    </tbody></table>
    <% } %>
    <p class="tiny muted" style="margin-top:8px">Đơn đặt sau khi khách bấm nút nào gần nhất. "Giao thành công" = đơn đã hoàn tất; đơn mới đặt chưa kịp giao nên tỷ lệ tăng dần theo ngày.</p>
  </section>
  <section class="panel">
    <div class="panel-head"><h2>Link đặt hàng cho từng kênh</h2></div>
    <p class="small muted" style="margin-bottom:10px">Gắn link này vào bio Facebook / Instagram / Zalo OA / TikTok. Khách bấm vào rồi tự đặt → đơn ghi đúng kênh.</p>
    <table class="table"><tbody>
      <% ['facebook', 'zalo', 'instagram', 'tiktok'].forEach((k) => { const link = `${siteUrl}/?nguon=${k}`; %>
      <tr><td><%= fmt.sourceLabel(k) %></td><td class="wrap mono tiny"><%= link %></td><td class="num"><button type="button" class="btn btn-sm btn-quiet" data-copy="<%= link %>">Sao chép</button></td></tr>
      <% }) %>
    </tbody></table>
  </section>
</div>
<%- include('_bottom') %>
