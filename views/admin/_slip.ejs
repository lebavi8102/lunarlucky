<%# Một phiếu giao + thiệp (dùng cho in 1 đơn và in hàng loạt). Cần: order, items %>
  <section class="slip">
    <header><div class="brand">LUNAR LUCKY<small>LUXURY GIFTS &amp; HAMPERS</small></div><div><b><%= order.code %></b><br>Giao ngày <%= fmt.deliveryWhen(order) %></div></header>
    <div class="cols">
      <div><h3>Người nhận</h3>
        <% if (order.is_gift) { %><p><b><%= order.recipient_name %></b><br><%= order.recipient_phone %><br><%= order.recipient_address %>, <%= order.province %></p>
        <% } else { %><p><b><%= order.customer_name %></b><br><%= order.phone %><br><%= order.address %>, <%= order.province %></p><% } %>
      </div>
      <div><h3>Thu hộ (COD)</h3><p class="cod"><%= pay.awaitingMoney(order) ? (order.payment_method === 'cod' ? 'CHƯA CỌC — KHÔNG GIAO' : 'CHƯA THANH TOÁN — KHÔNG GIAO') : pay.codDue(order) ? money(pay.codDue(order)) : '0₫ — đã thanh toán' %></p><% if (order.payment_status === 'deposit') { %><p class="note">Khách đã cọc <%= money(order.deposit_amount) %></p><% } %>
        <% if (order.is_gift) { %><p class="note">Đơn gửi tặng: không đưa hóa đơn giá tiền cho người nhận.</p><% } %>
      </div>
    </div>
    <h3>Danh sách đóng gói</h3>
    <table>
      <% items.forEach(i => { %>
        <tr><td><input type="checkbox" aria-label="Đã xếp"> <b><%= i.name %></b> × <%= i.qty %></td></tr>
      <% }) %>
    </table>
    <% if (order.note) { %><p class="note"><b>Ghi chú:</b> <%= order.note %></p><% } %>
  </section>

  <% if (order.card_message) { %>
  <section class="card-print">
    <div class="ornament">✦</div>
    <p class="msg"><%= order.card_message %></p>
  </section>
  <% } %>
