<%- include('_layout-top') %>
<% if (typeof reminder !== 'undefined' && reminder) { %>
<h1 style="font-family:'Times New Roman',Times,serif;font-weight:normal;font-size:26px;margin:0 0 8px">Giỏ quà của bạn vẫn đang được giữ</h1>
<p style="margin:0 0 20px;line-height:1.6;color:#4a3f38">Chào <%= order.customer_name %>, Lunar Lucky chưa nhận được <%= order.payment_method === 'cod' ? 'tiền cọc' : 'chuyển khoản' %> cho đơn <b><%= order.code %></b>. Giỏ quà được giữ đến <b><%= reminder.until %></b>; sau thời gian này đơn sẽ tự hủy để nhường hàng cho khách khác. Nếu bạn đã chuyển rồi, hãy bỏ qua email này hoặc trả lời kèm ảnh giao dịch.</p>
<% } else { %>
<h1 style="font-family:'Times New Roman',Times,serif;font-weight:normal;font-size:26px;margin:0 0 8px">Cảm ơn <%= order.customer_name %>!</h1>
<p style="margin:0 0 20px;line-height:1.6;color:#4a3f38">Lunar Lucky đã nhận đơn quà <b><%= order.code %></b>. <%= order.payment_method === 'bank' ? 'Đơn sẽ được chuẩn bị và giao ngay khi nhận được chuyển khoản.' : Number(order.deposit_amount) > 0 ? 'Đơn sẽ được giữ và chuẩn bị ngay khi nhận được tiền cọc.' : 'Lunar Lucky sẽ gọi xác nhận trước khi giao.' %></p>
<% } %>

<% if (qr) { %>
<table role="presentation" width="100%" style="border:1px solid #c9a15a;border-radius:10px;margin-bottom:24px">
<tr><td style="padding:16px 16px 0;text-align:center">
  <% const isDep = order.payment_method === 'cod' && Number(order.deposit_amount) > 0 && order.payment_status === 'pending'; %>
  <b style="font-size:15px"><%= order.payment_method === 'bank' ? 'Chuyển khoản để hoàn tất đơn' : isDep ? 'Đặt cọc ' + money(order.deposit_amount) + ' để giữ đơn — phần còn lại ' + money(order.total - order.deposit_amount) + ' trả khi nhận' : 'Muốn chuyển khoản trước thay vì trả tiền mặt? (không bắt buộc)' %></b>
  <img src="<%= qr %>" width="200" alt="Mã VietQR" style="display:block;margin:12px auto 0;max-width:100%;height:auto">
  <span style="display:block;font-size:12px;color:#75685e;margin-top:6px">Nhấn giữ ảnh QR → Lưu ảnh → mở app ngân hàng, quét QR từ thư viện ảnh</span>
</td></tr>
<tr><td style="padding:12px 16px 16px;font-size:14px;line-height:1.8">
  <% if (order.needs_vat) { %>Đơn xuất hóa đơn VAT — số tiền đã gồm phí xuất hóa đơn. Cần chuyển vào tài khoản công ty xuất hóa đơn? Nhắn Zalo Lunar Lucky<% if (typeof s !== "undefined" && s.zalo_url) { %>: <a href="<%= s.zalo_url %>"><%= s.zalo_url %></a><% } %><br><% } %>
  Ngân hàng: <%= payee.bankName || payee.bankId %><br>
  Số TK: <b><%= payee.account %></b><br>
  Chủ TK: <%= payee.holder %><br>
  Số tiền: <b style="color:#7a1622"><%= money(isDep ? order.deposit_amount : order.total) %></b><br>
  Nội dung: <b><%= order.code %></b>
</td></tr></table>
<% } %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px">
<% items.forEach(i => { %>
<tr><td style="padding:8px 0;border-bottom:1px solid #efe4d2"><%= i.name %> × <%= i.qty %></td><td align="right" style="padding:8px 0;border-bottom:1px solid #efe4d2"><%= money(i.line_total) %></td></tr>
<% }) %>
<tr><td style="padding:6px 0;color:#75685e">Tạm tính</td><td align="right"><%= money(order.subtotal) %></td></tr>
<% if (order.discount) { %><tr><td style="padding:6px 0;color:#75685e">Giảm giá (<%= order.coupon_code %>)</td><td align="right">−<%= money(order.discount) %></td></tr><% } %>
<tr><td style="padding:6px 0;color:#75685e">Phí giao hàng</td><td align="right"><%= order.shipping_fee ? money(order.shipping_fee) : 'Miễn phí' %></td></tr>
<% if (order.vat_fee) { %><tr><td style="padding:6px 0;color:#75685e">Phí xuất hóa đơn VAT<%= order.vat_fee_percent ? ' (' + Number(order.vat_fee_percent) + '%)' : '' %></td><td align="right"><%= money(order.vat_fee) %></td></tr><% } %>
<tr><td style="padding:12px 0;font-weight:bold;font-size:16px">Tổng cộng</td><td align="right" style="font-weight:bold;font-size:18px;color:#7a1622"><%= money(order.total) %></td></tr>
</table>

<p style="margin:20px 0 0;font-size:14px;line-height:1.7;color:#4a3f38">
  <b>Giao ngày:</b> <%= ymd(order.delivery_date) %><br>
  <b>Đến:</b> <%= order.is_gift ? `${order.recipient_name} · ${order.recipient_phone} · ${order.recipient_address}` : order.address %>, <%= order.province %>
  <% if (order.card_message) { %><br><b>Thiệp:</b> <i>“<%= order.card_message %>”</i><% } %>
</p>
<p style="margin:24px 0 0"><a href="<%= siteUrl %>/tra-cuu-don?ma=<%= order.code %>" style="display:inline-block;background:#7a1622;color:#fff;padding:12px 22px;border-radius:999px;text-decoration:none;font-weight:bold">Theo dõi đơn hàng</a></p>
<%- include('_layout-bottom') %>
