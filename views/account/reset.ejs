<%- include('../partials/top') %>
<div class="container auth-wrap">
  <h1>Đặt lại mật khẩu</h1>
  <% if (!valid) { %>
    <p class="sub">Liên kết không hợp lệ hoặc đã hết hạn.</p>
    <p class="auth-alt"><a href="/quen-mat-khau">Gửi lại liên kết mới</a></p>
  <% } else { %>
    <p class="sub">Chọn mật khẩu mới cho tài khoản của bạn.</p>
    <% if (error) { %><div class="flash flash-error" role="alert" style="margin-bottom:20px"><svg class="icon"><use href="#i-alert"/></svg><span><%= error %></span></div><% } %>
    <form class="card" action="/dat-lai-mat-khau/<%= token %>" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label class="label" for="password">Mật khẩu mới</label><input class="input" id="password" name="password" type="password" minlength="8" required autocomplete="new-password"><p class="help">Ít nhất 8 ký tự.</p></div>
      <button class="btn btn-lg btn-block" type="submit" style="margin-top:24px">Lưu mật khẩu</button>
    </form>
  <% } %>
</div>
<%- include('../partials/bottom') %>
