<%- include('../partials/top') %>
<article>
  <header class="container" style="max-width:860px;padding-block:48px 32px;text-align:center">
    <ol class="crumbs" aria-label="Breadcrumb" style="justify-content:center"><li><a href="/">Trang chủ</a></li><li><a href="/blog">Cẩm nang</a></li></ol>
    <h1 class="h2" style="margin-top:20px;font-size:clamp(36px,5vw,58px)"><%= post.title %></h1>
    <div class="meta" style="justify-content:center;margin-top:16px">
      <time datetime="<%= fmt.toDate(post.published_at)?.toISOString() %>"><%= fmt.longDate(post.published_at) %></time><span aria-hidden="true">·</span><span><%= minutes %> phút đọc</span>
    </div>
  </header>
  <% if (post.cover_id) { %>
  <div class="container" style="max-width:1080px"><div style="aspect-ratio:16/8;border-radius:20px;overflow:hidden;background:var(--cream-200)"><img src="<%= img(post.cover_id) %>" alt="" width="1600" height="800" style="width:100%;height:100%;object-fit:cover" fetchpriority="high"></div></div>
  <% } %>
  <div class="container" style="max-width:760px;padding-block:48px 64px">
    <% if (post.excerpt) { %><p class="serif" style="font-size:24px;line-height:1.5;color:var(--lacquer-800);margin-bottom:32px"><%= post.excerpt %></p><% } %>
    <div class="prose"><%- html %></div>
    <div class="divider" style="margin-top:56px"><svg viewBox="0 0 120 24" width="120" aria-hidden="true" class="icon" style="width:120px;height:24px"><use href="#i-cloud"/></svg></div>
  </div>
</article>

<% if (products.length) { %>
<section class="section" style="background:var(--cream-100)">
  <div class="container">
    <div class="section-head"><div class="stack"><span class="eyebrow">Gợi ý từ Lunar Lucky</span><h2 class="h2">Giỏ quà <em>được yêu thích</em></h2></div><a class="link-arrow" href="/bo-suu-tap">Xem bộ sưu tập <svg class="icon icon-sm"><use href="#i-arrow"/></svg></a></div>
    <div class="product-grid"><% products.forEach((p, i) => { %><%- include('../partials/product-card', { p, i }) %><% }) %></div>
  </div>
</section>
<% } %>

<% if (more.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head"><div class="stack"><span class="eyebrow">Đọc tiếp</span><h2 class="h2">Bài viết <em>khác</em></h2></div></div>
    <div class="post-grid">
      <% more.forEach((p) => { %>
      <article class="post-card">
        <div class="media"><img src="<%= img(p.cover_id) %>" alt="" loading="lazy" width="900" height="600"></div>
        <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
        <p><%= p.excerpt %></p>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
<%- include('../partials/bottom') %>
