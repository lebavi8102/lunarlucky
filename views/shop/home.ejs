<%- include('../partials/top') %>
<% const catById = Object.fromEntries(categories.map(c => [c.id, c.name])); const star = featured[0] || bestsellers[0]; %>

<section class="hero hero-home tet-hero">
  <div class="tet-hero-bg" aria-hidden="true"><picture><source media="(max-width: 767px)" srcset="/img/tet-den-long-1280.webp"><img src="/img/tet-den-long-2560.webp" alt="" width="2560" height="1080" decoding="async"></picture></div>
  <%- include('../partials/tet-petals') %>
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow"><%= s.hero_eyebrow %></span>
      <%# Tiêu đề: dấu " / " là chỗ xuống dòng; mỗi dòng không bị ngắt giữa chừng; từ "thịnh vượng" / "trọn vẹn" được nhấn nghiêng %>
      <% const heroLines = String(s.hero_title || '').split(/\s*\/\s*|\r?\n/).map((t) => t.trim()).filter(Boolean); %>
      <h1 class="display hero-title" style="margin-top:20px"><% heroLines.forEach((t) => { %><span class="line"><%- t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/(thịnh vượng|trọn vẹn)/i, '<em>$1</em>') %></span> <% }) %></h1>
      <p class="lead"><%= s.hero_subtitle %></p>
      <div class="hero-cta">
        <a class="btn btn-lg btn-gold" href="/bo-suu-tap">Chọn giỏ để gửi tặng <svg class="icon"><use href="#i-arrow"/></svg></a>
        <a class="btn btn-lg b2b-btn-light" href="/bo-suu-tap/qua-doanh-nghiep">Quà doanh nghiệp</a>
      </div>
      <ul class="hero-trust">
        <li><svg class="icon"><use href="#i-calendar"/></svg> Hà Nội giao đúng ngày hẹn</li>
        <li><svg class="icon"><use href="#i-gift"/></svg> Gửi tặng không kèm hóa đơn giá</li>
        <li><svg class="icon"><use href="#i-box"/></svg> Hộp sơn mài thủ công</li>
      </ul>
    </div>
    <div class="hero-visual hero-photo">
      <div class="photo"><picture><img src="/img/hero-crop-1220.webp" alt="Hai giỏ quà Tết Lunar Lucky: Giỏ Đại Cát đỏ vàng và Giỏ Thịnh Vượng kem xanh, đặt trên bệ đá cạnh cành hoa đào" width="1100" height="733" fetchpriority="high"></picture></div>
      <div class="hero-seal" aria-hidden="true"><span>Tết<b>2027</b>Đinh Mùi</span></div>
      <% if (star) { %>
      <a class="hero-float" href="/san-pham/<%= star.slug %>">
        <img src="<%= img(star.image_id) %>" alt="" width="56" height="56">
        <span><span class="tiny muted">Gợi ý từ Lunar Lucky</span><strong><%= star.name %></strong><span class="price small"><%= money(star.price) %></span></span>
      </a>
      <% } %>
    </div>
  </div>
</section>

<section class="usp" aria-label="Cam kết của Lunar Lucky">
  <div class="container usp-grid">
    <div class="usp-item"><svg class="icon"><use href="#i-leaf"/></svg><div><strong>Hạn dùng tối thiểu 3 tháng</strong><span>Không hàng cận date, nguồn gốc rõ ràng</span></div></div>
    <div class="usp-item"><svg class="icon"><use href="#i-truck"/></svg><div><strong>Hà Nội giao đúng ngày, đúng buổi</strong><span>Tỉnh khác 2–4 ngày · kèm ảnh khi quà tới tay</span></div></div>
    <div class="usp-item"><svg class="icon"><use href="#i-shield"/></svg><div><strong>Đổi mới nếu hư hỏng</strong><span>Hỗ trợ trong 24 giờ sau khi nhận</span></div></div>
  </div>
</section>

<section class="section-tight" aria-labelledby="budget-title" style="padding-bottom:0;padding-top:28px">
  <div class="container" style="text-align:center">
    <h2 id="budget-title" class="h3" style="margin-bottom:14px">Chọn nhanh theo ngân sách</h2>
    <ul class="chips" style="justify-content:center">
      <li><a class="chip" href="/bo-suu-tap?gia=duoi-1-trieu">Dưới 1 triệu</a></li>
      <li><a class="chip" href="/bo-suu-tap?gia=1-2-trieu">1 – 2 triệu</a></li>
      <li><a class="chip" href="/bo-suu-tap?gia=2-5-trieu">2 – 5 triệu</a></li>
      <li><a class="chip" href="/bo-suu-tap?gia=tren-5-trieu">Trên 5 triệu</a></li>
    </ul>
  </div>
</section>

<% if (featured.length) { %>
<section class="section featured-first has-motif">
  <img class="motif motif-mul motif-mai-tr" src="/img/motif/mai.webp" alt="" aria-hidden="true" width="600" height="600" loading="lazy" decoding="async">
  <img class="motif motif-ink motif-may-bl" src="/img/motif/may-vang.webp" alt="" aria-hidden="true" width="600" height="600" loading="lazy" decoding="async">
  <div class="container">
    <div class="section-head reveal">
      <div class="stack">
        <span class="eyebrow">Tuyển chọn mùa Tết</span>
        <h2 class="h2">Giỏ quà <em>nổi bật</em></h2>
      </div>
      <a class="link-arrow" href="/bo-suu-tap">Xem tất cả <svg class="icon icon-sm"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="product-grid cols-4 m-scroll">
      <% featured.forEach((p, i) => { %><%- include('../partials/product-card', { p, i, catName: catById[p.category_id] }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<%# Dải Tết: đếm ngày đến mùng 1 Tết Đinh Mùi (06/02/2027, giờ VN) — không hứa ưu đãi nào %>
<% const tetDays = Math.ceil((Date.UTC(2027, 1, 5, 17, 0, 0) - Date.now()) / 86400000); %>
<section class="tet-band" aria-label="Tết Đinh Mùi 2027">
  <div class="tet-band-bg" aria-hidden="true"><img src="/img/tet-den-long-2560.webp" alt="" width="2560" height="1080" loading="lazy" decoding="async"></div>
  <%- include('../partials/tet-petals') %>
  <img class="motif tet-lan" src="/img/motif/lan.webp" alt="" aria-hidden="true" width="700" height="700" loading="lazy" decoding="async">
  <div class="container tet-band-inner">
    <% if (tetDays > 0) { %>
    <div class="tet-count reveal" aria-hidden="true"><b><%= tetDays %></b><span>ngày nữa<br>là Tết</span></div>
    <% } %>
    <div class="tet-band-copy reveal">
      <span class="eyebrow">Tết Đinh Mùi 2027</span>
      <h2 class="h2"><%= tetDays > 0 ? 'Đặt sớm,' : 'Chúc mừng năm mới,' %> <em><%= tetDays > 0 ? 'chọn ngày giao đẹp' : 'an khang thịnh vượng' %></em></h2>
      <p class="lead">Giỏ quà chuẩn bị chỉn chu, giao đúng ngày anh chị hẹn<% if (tetDays > 0 && s.order_deadline_label) { %>. Lunar Lucky nhận đơn đến hết <strong><%= s.order_deadline_label %></strong><% } %>.</p>
      <div class="hero-cta">
        <a class="btn btn-lg btn-gold" href="/bo-suu-tap">Chọn giỏ quà Tết <svg class="icon"><use href="#i-arrow"/></svg></a>
        <a class="btn btn-lg b2b-btn-light" href="/bo-suu-tap/qua-doanh-nghiep#nhan-bao-gia">Báo giá doanh nghiệp</a>
      </div>
    </div>
    <ul class="tet-band-points reveal">
      <li><span><svg class="icon"><use href="#i-calendar"/></svg></span><div><strong>Chọn ngày giao</strong>Hà Nội giao đúng ngày hẹn</div></li>
      <li><span><svg class="icon"><use href="#i-gift"/></svg></span><div><strong>Gửi tặng thay bạn</strong>Không kèm hóa đơn giá</div></li>
      <li><span><svg class="icon"><use href="#i-building"/></svg></span><div><strong>Quà doanh nghiệp</strong>Báo giá riêng theo số lượng</div></li>
    </ul>
  </div>
</section>



<% if (categories.length) { %>
<section class="section has-motif sec-pattern">
  <img class="motif motif-mul motif-hac-bl" src="/img/motif/hac-sen.webp" alt="" aria-hidden="true" width="600" height="600" loading="lazy" decoding="async">
  <img class="motif motif-ink motif-may-tr" src="/img/motif/may-vang.webp" alt="" aria-hidden="true" width="600" height="600" loading="lazy" decoding="async">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow center">Bộ sưu tập</span>
      <h2 class="h2">Mỗi món quà, <em>trọn một lời chúc</em></h2>
      <p class="lead">Khám phá những giỏ quà Tết tinh tế dành tặng gia đình, bạn bè và đối tác. Đa dạng lựa chọn, phù hợp từng người nhận và ngân sách của bạn.</p>
    </div>
    <div class="cat-grid">
      <% categories.slice(0, 4).forEach((c, i) => { %>
      <a class="cat-card reveal" style="--d:<%= i * 90 %>ms" href="/bo-suu-tap/<%= c.slug %>">
        <div class="arch"><img src="<%= img(c.image_id) %>" alt="" loading="lazy" width="600" height="800"></div>
        <h3><%= c.name %></h3>
        <% if (c.tagline) { %><p><%= c.tagline %></p><% } %>
        <span class="cat-cta">Khám phá <svg class="icon icon-sm" aria-hidden="true"><use href="#i-arrow"/></svg></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>


<section class="section lacquer has-motif">
  <img class="motif motif-scr motif-hac-r" src="/img/motif/hac-vang.webp" alt="" aria-hidden="true" width="600" height="600" loading="lazy" decoding="async">
  <img class="motif motif-scr motif-may-tl" src="/img/motif/may-vang.webp" alt="" aria-hidden="true" width="600" height="600" loading="lazy" decoding="async">
  <div class="container split gift-split">
    <div class="reveal">
      <span class="eyebrow">Gửi quà thay bạn</span>
      <h2 class="h2" style="margin-top:16px">Trao tận tay, <em>trọn lời chúc</em></h2>
      <p class="lead" style="margin-top:20px">Dù chưa thể gặp gỡ, bạn vẫn có thể gửi trao sự quan tâm. Cùng Lunar Lucky chọn món quà Tết ý nghĩa, gửi đến gia đình, bạn bè và đối tác.</p>
      <ol class="steps">
        <li><div><strong>Chọn món quà</strong><span>Chọn giỏ quà phù hợp với người nhận và ngân sách của bạn.</span></div></li>
        <li><div><strong>Gửi thông tin &amp; lời chúc</strong><span>Cung cấp thông tin người nhận và lời nhắn bạn muốn gửi trao.</span></div></li>
        <li><div><strong>Xác nhận lịch giao</strong><span>Lunar Lucky tư vấn và xác nhận thời gian giao phù hợp với địa chỉ nhận quà.</span></div></li>
      </ol>
      <div class="hero-cta"><a class="btn btn-gold btn-lg" href="/bo-suu-tap" data-ai-start>Tư vấn gửi quà <svg class="icon"><use href="#i-arrow"/></svg></a></div>
    </div>
    <div class="gift-visual reveal" style="--d:150ms">
      <div class="gift-photo"><img src="/img/gift-delivery-900.webp" alt="Nhân viên Lunar Lucky trao giỏ quà Tết tận tay người nhận" loading="lazy" width="900" height="1125"></div>
    </div>
  </div>
</section>

<% if (bestsellers.length) { %>
<section class="section jade-sec has-motif">
  <img class="motif motif-scr motif-may-tl" src="/img/motif/may-vang.webp" alt="" aria-hidden="true" width="600" height="600" loading="lazy" decoding="async">
  <img class="motif motif-scr motif-hac-br" src="/img/motif/hac-vang.webp" alt="" aria-hidden="true" width="600" height="600" loading="lazy" decoding="async">
  <div class="container">
    <div class="section-head reveal">
      <div class="stack">
        <span class="eyebrow">Được yêu thích</span>
        <h2 class="h2">Bán chạy <em>nhất mùa</em></h2>
      </div>
      <a class="link-arrow" href="/bo-suu-tap?sap_xep=ban-chay">Xem thêm <svg class="icon icon-sm"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="product-grid cols-4 m-scroll">
      <% bestsellers.forEach((p, i) => { %><%- include('../partials/product-card', { p, i, catName: catById[p.category_id] }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (reviews && reviews.length) { %>
<section class="section" style="padding-top:0" aria-labelledby="reviews-title">
  <div class="container">
    <div class="section-head reveal">
      <div class="stack">
        <span class="eyebrow">Ảnh thật lúc giao</span>
        <h2 class="h2" id="reviews-title">Khách đã <em>nhận quà</em></h2>
      </div>
    </div>
    <%- include('../partials/reviews', { reviews }) %>
  </div>
</section>
<% } %>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="b2b-card b2b-card-art reveal">
      <div>
        <span class="eyebrow">Quà tặng doanh nghiệp</span>
        <h2 class="h2" style="margin-top:16px"><span style="display:block">Tri ân đối tác,</span> <em style="white-space:nowrap">chỉn chu từng chi tiết</em></h2>
        <p class="lead" style="margin-top:20px">Lunar Lucky cùng doanh nghiệp lựa chọn quà Tết phù hợp ngân sách, chăm chút dấu ấn thương hiệu và sắp xếp giao nhận theo nhu cầu.</p>
        <div class="hero-cta corp-cta">
          <a class="btn btn-lg" href="/bo-suu-tap/qua-doanh-nghiep#nhan-bao-gia">Nhận báo giá doanh nghiệp</a>
          <a class="btn btn-lg btn-quiet" href="/bo-suu-tap/qua-doanh-nghiep">Xem quà doanh nghiệp</a>
        </div>
      </div>
      <ul class="feature-list two corp-features">
        <li><span class="feature-ico"><svg class="icon"><use href="#i-sparkle"/></svg></span><div><strong>Dấu ấn thương hiệu</strong><span>Tùy chỉnh logo doanh nghiệp theo yêu cầu.</span></div></li>
        <li><span class="feature-ico"><svg class="icon"><use href="#i-file"/></svg></span><div><strong>Hóa đơn VAT</strong><span>Hỗ trợ xuất hóa đơn cho doanh nghiệp.</span></div></li>
        <li><span class="feature-ico"><svg class="icon"><use href="#i-truck"/></svg></span><div><strong>Giao nhiều địa chỉ</strong><span>Sắp xếp giao quà theo danh sách người nhận.</span></div></li>
        <li><span class="feature-ico"><svg class="icon"><use href="#i-tag"/></svg></span><div><strong>Ưu đãi số lượng</strong><span>Báo giá theo số lượng và ngân sách.</span></div></li>
      </ul>
      <figure class="tet-arch b2b-arch" aria-hidden="true"><img src="/img/motif/tranh-hac.webp" alt="" width="900" height="1200" loading="lazy" decoding="async"></figure>
    </div>
  </div>
</section>

<section class="section journey-sec has-motif">
  <img class="motif motif-ink motif-may-tl" src="/img/motif/may-vang.webp" alt="" aria-hidden="true" width="600" height="600" loading="lazy" decoding="async">
  <img class="motif motif-mul motif-mai-tr" src="/img/motif/mai.webp" alt="" aria-hidden="true" width="600" height="600" loading="lazy" decoding="async">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow center">Hành trình một giỏ quà</span>
      <h2 class="h2">Chỉn chu từng bước, <em>trọn vẹn món quà</em></h2>
    </div>
  </div>
  <div class="journey-banner">
    <img class="jb-img" src="/img/journey-banner-2000.webp" alt="Ba bước làm nên một giỏ quà Lunar Lucky: tuyển chọn, đóng gói, trao tận tay" width="2000" height="750" loading="lazy">
    <ol class="jb-steps">
      <li class="reveal"><div class="jb-photo" aria-hidden="true"></div><span class="jb-num">01</span><h3>Tuyển chọn</h3><p>Chọn kỹ từng sản phẩm, chú trọng chất lượng và nguồn gốc để món quà xứng đáng trao gửi.</p></li>
      <li class="reveal" style="--d:90ms"><div class="jb-photo" aria-hidden="true"></div><span class="jb-num">02</span><h3>Đóng gói</h3><p>Tỉ mỉ xếp giỏ, lót giấy và thắt nơ, chỉn chu để sẵn sàng trao tặng.</p></li>
      <li class="reveal" style="--d:180ms"><div class="jb-photo" aria-hidden="true"></div><span class="jb-num">03</span><h3>Trao tận tay</h3><p>Xác nhận thông tin trước khi giao, gửi trao món quà cùng lời chúc đến người nhận.</p></li>
    </ol>
  </div>
</section>

<% if (posts.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <div class="stack">
        <span class="eyebrow">Cẩm nang</span>
        <h2 class="h2">Chuyện <em>quà Tết</em></h2>
      </div>
      <a class="link-arrow" href="/blog">Đọc thêm <svg class="icon icon-sm"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="post-grid">
      <% posts.forEach((p, i) => { %>
      <article class="post-card reveal" style="--d:<%= i * 90 %>ms">
        <div class="media"><img src="<%= img(p.cover_id) %>" alt="" loading="lazy" width="900" height="600"></div>
        <div class="meta"><time datetime="<%= fmt.toDate(p.published_at)?.toISOString() %>"><%= fmt.longDate(p.published_at) %></time></div>
        <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
        <p><%= p.excerpt %></p>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="social-cta reveal">
      <h2 class="h2">Cùng bạn chọn món quà ý nghĩa</h2>
      <p class="lead" style="margin:16px auto 0">Cho Lunar Lucky biết người nhận và ngân sách dự kiến, chúng tôi sẽ gợi ý giỏ quà phù hợp cùng lời chúc bạn muốn gửi trao.</p>
      <div class="btns">
        <a class="btn btn-lg" href="<%= s.zalo_url %>" target="_blank" rel="noopener">Tư vấn qua Zalo</a>
        <a class="btn btn-lg btn-ghost" href="<%= s.fanpage_url %>" target="_blank" rel="noopener"><svg class="icon"><use href="#i-facebook"/></svg> Nhắn qua Facebook</a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
