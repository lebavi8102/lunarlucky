<%- include('../partials/top') %>
<% const catById = Object.fromEntries(categories.map(c => [c.id, c.name])); const star = featured[0] || bestsellers[0]; %>

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow"><%= s.hero_eyebrow %></span>
      <h1 class="display" style="margin-top:20px"><%- s.hero_title.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/(trọn vẹn)/i, '<em>$1</em>') %></h1>
      <p class="lead"><%= s.hero_subtitle %></p>
      <div class="hero-cta">
        <a class="btn btn-lg" href="/bo-suu-tap">Khám phá bộ sưu tập <svg class="icon"><use href="#i-arrow"/></svg></a>
        <a class="btn btn-lg btn-ghost" href="/qua-tang-doanh-nghiep">Quà doanh nghiệp</a>
      </div>
      <ul class="hero-trust">
        <li><svg class="icon"><use href="#i-calendar"/></svg> Giao đúng ngày hẹn</li>
        <li><svg class="icon"><use href="#i-pen"/></svg> Thiệp viết tay miễn phí</li>
        <li><svg class="icon"><use href="#i-box"/></svg> Hộp sơn mài thủ công</li>
      </ul>
    </div>
    <div class="hero-visual">
      <span class="arch-outline" aria-hidden="true"></span>
      <div class="arch"><img src="/img/hero.svg" alt="Giỏ quà Tết Lunar với hộp sơn mài đỏ, cành mai vàng và trăng rằm" width="800" height="1000" fetchpriority="high"></div>
      <div class="hero-seal" aria-hidden="true"><span>Tết<b>2027</b>Đinh Mùi</span></div>
      <% if (star) { %>
      <a class="hero-float" href="/san-pham/<%= star.slug %>">
        <img src="<%= img(star.image_id) %>" alt="" width="56" height="56">
        <span><span class="tiny muted">Gợi ý từ Lunar</span><strong><%= star.name %></strong><span class="price small"><%= money(star.price) %></span></span>
      </a>
      <% } %>
    </div>
  </div>
</section>

<section class="usp" aria-label="Cam kết của Lunar">
  <div class="container usp-grid">
    <div class="usp-item"><svg class="icon"><use href="#i-leaf"/></svg><div><strong>Tuyển chọn ba miền</strong><span>Đặc sản có nguồn gốc rõ ràng</span></div></div>
    <div class="usp-item"><svg class="icon"><use href="#i-gift"/></svg><div><strong>Gói quà tinh tế</strong><span>Hộp sơn mài, nơ lụa, thiệp viết tay</span></div></div>
    <div class="usp-item"><svg class="icon"><use href="#i-truck"/></svg><div><strong>Giao đúng ngày</strong><span>Bạn chọn ngày, Lunar giao tận tay</span></div></div>
    <div class="usp-item"><svg class="icon"><use href="#i-shield"/></svg><div><strong>Đổi mới nếu hư hỏng</strong><span>Hỗ trợ trong 24 giờ sau khi nhận</span></div></div>
  </div>
</section>

<% if (categories.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow center">Bộ sưu tập</span>
      <h2 class="h2">Mỗi lời chúc, <em>một dáng quà</em></h2>
      <p class="lead">Từ hộp quà nhỏ xinh gửi bạn bè đến giỏ quà sơn mài biếu đối tác, chọn theo người nhận và ngân sách của bạn.</p>
    </div>
    <div class="cat-grid">
      <% categories.slice(0, 4).forEach((c, i) => { %>
      <a class="cat-card reveal" style="--d:<%= i * 90 %>ms" href="/bo-suu-tap/<%= c.slug %>">
        <div class="arch"><img src="<%= img(c.image_id) %>" alt="" loading="lazy" width="600" height="800"></div>
        <h3><%= c.name %></h3>
        <% if (c.tagline) { %><p><%= c.tagline %></p><% } %>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="section-head reveal">
      <div class="stack">
        <span class="eyebrow">Tuyển chọn mùa Tết</span>
        <h2 class="h2">Giỏ quà <em>nổi bật</em></h2>
      </div>
      <a class="link-arrow" href="/bo-suu-tap">Xem tất cả <svg class="icon icon-sm"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="product-grid cols-4">
      <% featured.forEach((p, i) => { %><%- include('../partials/product-card', { p, i, catName: catById[p.category_id] }) %><% }) %>
    </div>
  </div>
</section>

<section class="section lacquer">
  <div class="container split">
    <div class="reveal">
      <span class="eyebrow">Gửi quà thay bạn</span>
      <h2 class="h2" style="margin-top:16px">Trao tận tay, <em>trọn lời chúc</em></h2>
      <p class="lead" style="margin-top:20px">Không kịp về quê hay ghé thăm đối tác? Chỉ cần chọn giỏ quà, Lunar sẽ thay bạn gửi lời chúc đến đúng người, đúng ngày.</p>
      <ol class="steps">
        <li><div><strong>Chọn giỏ quà</strong><span>Mỗi giỏ đã được Lunar tuyển chọn và phối sẵn, hài hòa về hương vị lẫn ý nghĩa.</span></div></li>
        <li><div><strong>Gửi lời nhắn</strong><span>Lunar viết tay lời chúc của bạn lên thiệp giấy dó, không kèm hóa đơn giá tiền.</span></div></li>
        <li><div><strong>Chọn ngày giao</strong><span>Giao đến người nhận trong ngày bạn hẹn, kèm ảnh xác nhận khi quà đã tới tay.</span></div></li>
      </ol>
      <div class="hero-cta"><a class="btn btn-gold btn-lg" href="/bo-suu-tap">Chọn giỏ quà <svg class="icon"><use href="#i-arrow"/></svg></a></div>
    </div>
    <div class="gift-visual reveal" style="--d:150ms">
      <div class="arch"><img src="/img/gifting.svg" alt="Hộp quà Tết xếp tầng thắt nơ vàng" loading="lazy" width="800" height="880"></div>
    </div>
  </div>
</section>

<% if (bestsellers.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <div class="stack">
        <span class="eyebrow">Được yêu thích</span>
        <h2 class="h2">Bán chạy <em>nhất mùa</em></h2>
      </div>
      <a class="link-arrow" href="/bo-suu-tap?sap_xep=ban-chay">Xem thêm <svg class="icon icon-sm"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="product-grid cols-4">
      <% bestsellers.forEach((p, i) => { %><%- include('../partials/product-card', { p, i, catName: catById[p.category_id] }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="b2b-card reveal">
      <div>
        <span class="eyebrow">Quà tặng doanh nghiệp</span>
        <h2 class="h2" style="margin-top:16px">Tri ân đối tác, <em>chỉn chu từng chi tiết</em></h2>
        <p class="lead" style="margin-top:20px">Lunar đồng hành cùng doanh nghiệp từ khâu chọn ngân sách đến giao hàng loạt, để món quà mang đúng tinh thần thương hiệu của bạn.</p>
        <div class="hero-cta">
          <a class="btn btn-lg" href="/qua-tang-doanh-nghiep#bao-gia">Nhận báo giá trong 24h</a>
          <a class="btn btn-lg btn-quiet" href="/qua-tang-doanh-nghiep">Tìm hiểu thêm</a>
        </div>
      </div>
      <ul class="feature-list two">
        <li><span class="feature-ico"><svg class="icon"><use href="#i-sparkle"/></svg></span><div><strong>In logo thương hiệu</strong><span>Trên hộp, nơ và thiệp chúc</span></div></li>
        <li><span class="feature-ico"><svg class="icon"><use href="#i-file"/></svg></span><div><strong>Hóa đơn VAT</strong><span>Đầy đủ chứng từ cho kế toán</span></div></li>
        <li><span class="feature-ico"><svg class="icon"><use href="#i-truck"/></svg></span><div><strong>Giao theo danh sách</strong><span>Đến từng đối tác, toàn quốc</span></div></li>
        <li><span class="feature-ico"><svg class="icon"><use href="#i-tag"/></svg></span><div><strong>Giá theo số lượng</strong><span>Ưu đãi tăng dần từ 20 giỏ</span></div></li>
      </ul>
    </div>
  </div>
</section>

<section class="section" style="background:var(--cream-100)">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow center">Hành trình một giỏ quà</span>
      <h2 class="h2">Chậm rãi, <em>tỉ mỉ</em>, đúng hẹn</h2>
    </div>
    <ol class="journey">
      <li class="reveal"><h3>Tuyển chọn</h3><p>Lunar làm việc trực tiếp với nhà vườn, xưởng trà và lò bánh để chọn từng món đạt chuẩn.</p></li>
      <li class="reveal" style="--d:90ms"><h3>Đóng gói</h3><p>Mỗi giỏ được xếp tay, lót giấy lụa và thắt nơ, sẵn sàng để trao mà không cần gói lại.</p></li>
      <li class="reveal" style="--d:180ms"><h3>Viết thiệp</h3><p>Lời chúc của bạn được chép tay bằng mực nho lên thiệp giấy dó.</p></li>
      <li class="reveal" style="--d:270ms"><h3>Trao tận tay</h3><p>Lunar gọi xác nhận trước khi giao và gửi ảnh giỏ quà khi đã đến nơi.</p></li>
    </ol>
  </div>
</section>

<% if (posts.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <div class="stack">
        <span class="eyebrow">Cẩm nang</span>
        <h2 class="h2">Chuyện <em>quà Tết</em></h2>
      </div>
      <a class="link-arrow" href="/blog">Đọc thêm <svg class="icon icon-sm"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="post-grid">
      <% posts.forEach((p, i) => { %>
      <article class="post-card reveal" style="--d:<%= i * 90 %>ms">
        <div class="media"><img src="<%= img(p.cover_id) %>" alt="" loading="lazy" width="900" height="600"></div>
        <div class="meta"><time datetime="<%= fmt.toDate(p.published_at)?.toISOString() %>"><%= fmt.longDate(p.published_at) %></time></div>
        <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
        <p><%= p.excerpt %></p>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="social-cta reveal">
      <svg class="ornament" viewBox="0 0 120 24" aria-hidden="true"><use href="#i-cloud"/></svg>
      <h2 class="h2">Cần tư vấn chọn quà?</h2>
      <p class="lead" style="margin:16px auto 0">Nhắn cho Lunar qua Zalo hoặc fanpage, chúng tôi sẽ gợi ý giỏ quà hợp người nhận và ngân sách trong vài phút.</p>
      <div class="btns">
        <a class="btn btn-lg" href="<%= s.zalo_url %>" target="_blank" rel="noopener">Nhắn Zalo</a>
        <a class="btn btn-lg btn-ghost" href="<%= s.fanpage_url %>" target="_blank" rel="noopener"><svg class="icon"><use href="#i-facebook"/></svg> Fanpage Lunar</a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
