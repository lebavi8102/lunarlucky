<%- include('../partials/top') %>
<% const catById = Object.fromEntries(categories.map(c => [c.id, c.name]));
   const sortLabels = { 'noi-bat': 'Nổi bật', 'ban-chay': 'Bán chạy', 'gia-tang': 'Giá tăng dần', 'gia-giam': 'Giá giảm dần', 'moi-nhat': 'Mới nhất' };
   const rangeLabels = { 'duoi-1-trieu': 'Dưới 1 triệu', '1-2-trieu': '1 – 2 triệu', '2-5-trieu': '2 – 5 triệu', 'tren-5-trieu': 'Trên 5 triệu' };
   const landing = locals.landing || null;
   const isB2b = !!(category && category.slug === 'qua-doanh-nghiep' && !landing);
   const bulkFrom = Number(s.ai_escalate_qty) || 5;
   const basePath = landing ? landing.path : (category ? '/bo-suu-tap/' + category.slug : '/bo-suu-tap');
   const qs = (o) => { const q = new URLSearchParams(Object.entries({ sap_xep: sort !== 'noi-bat' ? sort : '', gia: range, ...o }).filter(([, v]) => v)); const s2 = q.toString(); return s2 ? '?' + s2 : ''; };
%>
<% if (isB2b) { %>
<section class="b2b-hero">
  <picture class="b2b-hero-bg" aria-hidden="true">
    <source media="(max-width: 767px)" srcset="/img/b2b-tet-1280.webp">
    <img src="/img/b2b-tet-2560.webp" alt="" width="2560" height="1080" fetchpriority="high" decoding="async">
  </picture>
  <div class="container b2b-hero-inner">
    <ol class="crumbs" aria-label="Breadcrumb">
      <li><a href="/">Trang chủ</a></li><li><a href="/bo-suu-tap">Bộ sưu tập</a></li><li aria-current="page"><%= category.name %></li>
    </ol>
    <span class="eyebrow">Quà Tết doanh nghiệp 2027</span>
    <h1>Quà tặng doanh nghiệp<br><em>trao lời chúc thịnh vượng</em></h1>
    <p class="lead">Giỏ quà Tết cho nhân viên, đối tác và khách hàng. Báo giá riêng theo số lượng, in logo doanh nghiệp, giao theo danh sách người nhận.</p>
    <div class="b2b-hero-cta">
      <a class="btn btn-gold btn-lg" href="#nhan-bao-gia">Nhận báo giá &amp; catalogue</a>
      <a class="btn btn-lg b2b-btn-light" href="<%= s.zalo_url %>" target="_blank" rel="noopener">Nhắn Zalo tư vấn</a>
    </div>
    <ul class="b2b-hero-points">
      <li><svg class="icon icon-sm"><use href="#i-tag"/></svg><span>Từ <%= bulkFrom %> giỏ: <strong>báo giá riêng</strong></span></li>
      <li><svg class="icon icon-sm"><use href="#i-sparkle"/></svg><span><strong>In logo</strong> doanh nghiệp</span></li>
      <li><svg class="icon icon-sm"><use href="#i-truck"/></svg><span>Giao theo <strong>danh sách</strong> người nhận</span></li>
      <li><svg class="icon icon-sm"><use href="#i-clock"/></svg><span>Phản hồi trong <strong>24 giờ</strong></span></li>
    </ul>
  </div>
</section>
<% } else { %>
<section class="page-head collection-head tet-head">
  <div class="container">
    <ol class="crumbs" aria-label="Breadcrumb">
      <li><a href="/">Trang chủ</a></li>
      <% if (landing) { %><li aria-current="page"><%= landing.crumb %></li>
      <% } else if (category) { %><li><a href="/bo-suu-tap">Bộ sưu tập</a></li><li aria-current="page"><%= category.name %></li>
      <% } else { %><li aria-current="page">Bộ sưu tập</li><% } %>
    </ol>
    <h1><%= landing ? landing.h1 : (category ? category.name : 'Tất cả giỏ quà Tết 2027') %></h1>
    <p class="lead"><%= landing ? landing.lead : (category ? (category.description || category.tagline) : 'Giỏ quà Tết cao cấp biếu sếp, đối tác, gia đình và tặng nhân viên. Mỗi giỏ đều được tuyển chọn và đóng gói thủ công, giao đúng ngày hẹn tại Hà Nội và toàn quốc.') %></p>
  </div>
</section>
<% } %>
<% if (isB2b) { %>
<div class="container">
  <aside class="b2b-price-note" aria-label="Giá doanh nghiệp">
    <span class="b2b-price-note-ico" aria-hidden="true"><svg class="icon"><use href="#i-info"/></svg></span>
    <p><strong>Giá hiển thị bên dưới là giá lẻ (mua 1 giỏ).</strong> Đặt từ <%= bulkFrom %> giỏ trở lên có <strong>báo giá số lượng riêng</strong>, gửi kèm catalogue quà Tết doanh nghiệp 2027.</p>
    <a class="b2b-price-note-link" href="#nhan-bao-gia">Nhận báo giá <svg class="icon icon-sm"><use href="#i-arrow"/></svg></a>
  </aside>
</div>
<% } %>

<section class="section-tight collection-section">
  <div class="container">
    <nav aria-label="Danh mục" class="cat-scroll" style="margin-bottom:20px;overflow-x:auto">
      <ul class="chips" style="flex-wrap:nowrap">
        <li><a class="chip" href="/bo-suu-tap" aria-current="<%= !category %>">Tất cả</a></li>
        <% categories.forEach(c => { %><li><a class="chip" href="/bo-suu-tap/<%= c.slug %>" aria-current="<%= !!(category && category.id === c.id) %>"><%= c.name %></a></li><% }) %>
      </ul>
    </nav>
    <%# Điện thoại: một hàng gọn (khoảng giá + sắp xếp), danh mục là hàng chip cuộn ngang %>
    <form class="filter-row" method="get" action="<%= basePath %>" data-autosubmit>
      <label class="sr-only" for="gia-m">Khoảng giá</label>
      <select class="select" id="gia-m" name="gia">
        <option value="">Mọi mức giá</option>
        <% for (const r of ranges) { %><option value="<%= r %>" <%= r === range ? 'selected' : '' %>><%= rangeLabels[r] %></option><% } %>
      </select>
      <label class="sr-only" for="sort-m">Sắp xếp</label>
      <select class="select" id="sort-m" name="sap_xep">
        <% for (const k of sorts) { %><option value="<%= k %>" <%= k === sort ? 'selected' : '' %>><%= sortLabels[k] %></option><% } %>
      </select>
    </form>
    <div class="toolbar">
      <ul class="chips" aria-label="Khoảng giá">
        <% for (const r of ranges) { %>
          <li><a class="chip" href="<%= basePath + qs({ gia: range === r ? '' : r }) %>" aria-current="<%= range === r %>"><%= rangeLabels[r] %></a></li>
        <% } %>
      </ul>
      <form method="get" action="<%= basePath %>" data-autosubmit>
        <% if (range) { %><input type="hidden" name="gia" value="<%= range %>"><% } %>
        <label class="small muted" for="sort">Sắp xếp</label>
        <select class="select" id="sort" name="sap_xep" style="min-height:44px;width:auto">
          <% for (const k of sorts) { %><option value="<%= k %>" <%= k === sort ? 'selected' : '' %>><%= sortLabels[k] %></option><% } %>
        </select>
        <noscript><button class="btn btn-sm" type="submit">Áp dụng</button></noscript>
      </form>
    </div>
    <p class="small muted collection-count" style="margin-bottom:24px"><%= total %> giỏ quà</p>

    <% if (products.length) { %>
      <div class="product-grid cols-4">
        <% products.forEach((p, i) => { %><%- include('../partials/product-card', { p, i, catName: category ? null : catById[p.category_id], b2bNote: isB2b ? bulkFrom : 0 }) %><% }) %>
      </div>
      <%- include('../partials/pagination', { baseQuery: { sap_xep: sort !== 'noi-bat' ? sort : '', gia: range } }) %>
    <% } else { %>
      <div class="empty">
        <svg class="icon"><use href="#i-gift"/></svg>
        <h2 class="h3">Chưa có giỏ quà phù hợp</h2>
        <p class="muted" style="margin-top:8px">Thử chọn khoảng giá khác, hoặc nhắn Lunar Lucky để được gợi ý giỏ quà phù hợp ngân sách.</p>
        <div class="hero-cta" style="justify-content:center"><a class="btn" href="<%= s.zalo_url %>" target="_blank" rel="noopener">Nhắn Zalo tư vấn</a><a class="btn btn-quiet" href="/bo-suu-tap">Xem tất cả</a></div>
      </div>
    <% } %>
  </div>
</section>
<% if (isB2b) { const budgets = ['Cần tư vấn', 'Dưới 500.000₫', '500.000₫ – 1.000.000₫', '1.000.000₫ – 2.000.000₫', '2.000.000₫ – 5.000.000₫', 'Trên 5.000.000₫']; %>
<section class="section quote-section b2b-catalogue" id="nhan-bao-gia">
  <div class="b2b-catalogue-bg" aria-hidden="true"><img src="/img/b2b-tet-1280.webp" alt="" width="1280" height="540" loading="lazy" decoding="async"></div>
  <div class="container split" style="align-items:start">
    <div>
      <span class="eyebrow">Báo giá số lượng</span>
      <h2 class="h2" style="margin-top:16px">Nhận <em>báo giá &amp; catalogue</em> quà Tết doanh nghiệp</h2>
      <p class="lead" style="margin-top:20px">Để lại số giỏ và ngân sách, Lunar Lucky gửi qua Zalo bảng giá theo số lượng cùng catalogue đầy đủ các mẫu, thường trong ngày làm việc.</p>
      <ul class="feature-list" style="margin-top:32px">
        <li><span class="feature-ico"><svg class="icon"><use href="#i-file"/></svg></span><div><strong>Báo giá theo số lượng</strong><span>Đặt càng nhiều giá càng tốt. Giá hiển thị trên trang là giá lẻ 1 giỏ.</span></div></li>
        <li><span class="feature-ico"><svg class="icon"><use href="#i-gift"/></svg></span><div><strong>Catalogue đầy đủ mẫu</strong><span>Ảnh thật và thành phần từng giỏ, tiện chọn và trình duyệt nội bộ.</span></div></li>
        <li><span class="feature-ico"><svg class="icon"><use href="#i-sparkle"/></svg></span><div><strong>In logo doanh nghiệp</strong><span>Tư vấn cách in logo theo mẫu và số lượng.</span></div></li>
      </ul>
    </div>
    <div class="card">
      <% if (locals.sent) { %>
        <div style="text-align:center;padding:24px 0" role="status">
          <div class="order-hero" style="padding:0"><div class="seal"><svg class="icon"><use href="#i-check"/></svg></div></div>
          <h3 class="h3">Lunar Lucky đã nhận yêu cầu</h3>
          <p class="muted" style="margin-top:8px">Bên em sẽ gửi báo giá số lượng và catalogue qua Zalo theo số điện thoại anh/chị để lại. Cảm ơn anh/chị đã tin chọn Lunar Lucky.</p>
          <div class="hero-cta" style="justify-content:center;margin-top:16px"><a class="btn" href="<%= s.zalo_url %>" target="_blank" rel="noopener">Nhắn Zalo ngay</a><a class="btn btn-quiet" href="tel:<%= s.shop_phone.replace(/\s/g,'') %>">Gọi <%= s.shop_phone %></a></div>
        </div>
      <% } else { %>
      <form action="/qua-tang-doanh-nghiep" method="post" data-quote-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="nguon" value="bo-suu-tap">
        <input type="hidden" name="catalogue" value="1">
        <div style="position:absolute;left:-9999px" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
        <div class="grid-2">
          <%- include('../partials/field', { name: 'contact_name', label: 'Người liên hệ', required: true, autocomplete: 'name' }) %>
          <%- include('../partials/field', { name: 'phone', label: 'Số điện thoại / Zalo', type: 'tel', required: true, autocomplete: 'tel', inputmode: 'tel' }) %>
        </div>
        <div class="grid-2" style="margin-top:16px;align-items:end">
          <%- include('../partials/field', { name: 'quantity', label: 'Số lượng dự kiến', type: 'number', min: 5, inputmode: 'numeric', placeholder: 'VD: 50' }) %>
          <%- include('../partials/field', { name: 'budget', label: 'Ngân sách mỗi giỏ', as: 'select', options: budgets }) %>
        </div>
        <div style="margin-top:16px"><%- include('../partials/field', { name: 'company', label: 'Tên doanh nghiệp', optional: true, autocomplete: 'organization' }) %></div>
        <button class="btn btn-lg btn-block" type="submit" style="margin-top:24px" data-quote-submit>Nhận báo giá &amp; catalogue</button>
        <p class="small muted" style="margin-top:12px;text-align:center">Gửi yêu cầu không đồng nghĩa với đặt hàng hoặc thanh toán.</p>
      </form>
      <% } %>
    </div>
  </div>
</section>
<% } %>
<% if (landing) { %>
<section class="section-tight">
  <div class="container prose" style="max-width:760px">
    <% landing.blocks.forEach(b => { %>
      <h2 class="h3"><%= b.h %></h2>
      <% b.p.forEach(t => { %><p><%= t %></p><% }) %>
    <% }) %>
  </div>
</section>
<section class="section-tight">
  <div class="container faq" style="max-width:760px">
    <h2 class="h3" style="margin-bottom:16px">Câu hỏi thường gặp khi đặt giỏ quà Tết ở Hà Nội</h2>
    <% landing.faqs.forEach((f, i) => { %>
    <details <%= i === 0 ? 'open' : '' %>>
      <summary><%= f.q %><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></summary>
      <p><%= f.a %></p>
    </details>
    <% }) %>
  </div>
</section>
<% } %>
<%- include('../partials/bottom') %>
