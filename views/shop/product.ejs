<%- include('../partials/top') %>
<% const save = product.compare_price && product.compare_price > product.price ? Math.round((1 - product.price / product.compare_price) * 100) : 0; %>
<div class="container">
  <ol class="crumbs pdp-crumbs" aria-label="Breadcrumb">
    <li><a href="/">Trang chủ</a></li>
    <li><a href="/bo-suu-tap">Bộ sưu tập</a></li>
    <% if (category) { %><li><a href="/bo-suu-tap/<%= category.slug %>"><%= category.name %></a></li><% } %>
    <li aria-current="page"><%= product.name %></li>
  </ol>

  <div class="pdp">
    <div class="pdp-gallery" data-gallery>
      <div class="gallery-main">
        <img src="<%= img(gallery[0]) %>" alt="<%= product.name %>" width="800" height="1000" fetchpriority="high" data-gallery-main>
      </div>
      <% if (gallery.length > 1) { %>
      <ul class="thumbs" aria-label="Ảnh sản phẩm">
        <% gallery.forEach((id, i) => { %>
          <li><button type="button" aria-label="Xem ảnh <%= i + 1 %>" aria-current="<%= i === 0 %>" data-src="<%= img(id) %>"><img src="<%= img(id) %>" alt="" loading="lazy" width="76" height="92"></button></li>
        <% }) %>
      </ul>
      <% } %>
      <% if (product.video_url && /^(https?:)?\/\//.test(product.video_url)) { %>
      <a class="btn btn-quiet btn-block gallery-video" href="<%= product.video_url %>" target="_blank" rel="noopener"><svg class="icon"><use href="#i-play"/></svg> Xem video giỏ thực tế</a>
      <% } %>
    </div>

    <div class="pdp-info">
      <% if (category) { %><a class="eyebrow" href="/bo-suu-tap/<%= category.slug %>"><%= category.name %></a><% } %>
      <h1><%= product.name %></h1>
      <div class="price">
        <span><%= money(product.price) %></span>
        <% if (save) { %><del><%= money(product.compare_price) %></del><span class="save">Tiết kiệm <%= save %>%</span><% } %>
      </div>
      <% const freeShip = Number(s.free_ship_threshold) || 0;
         const twoSentences = (t) => { const m = String(t || '').match(/[^.!?]+[.!?]+(\s|$)/g); return m ? m.slice(0, 2).join('').trim() : String(t || '').trim(); }; %>
      <% if (product.short_desc) { %><p class="short"><%= twoSentences(product.short_desc) %></p><% } %>
      <p class="ship-promise">
        <svg class="icon icon-sm"><use href="#i-truck"/></svg>
        <span>Giao từ <b><%= earliest.slice(8) %>/<%= earliest.slice(5, 7) %></b> tại Hà Nội · tỉnh khác 2–4 ngày<br>
        <% if (freeShip && product.price >= freeShip) { %><b style="color:var(--jade-700)">Miễn phí giao hàng</b> cho giỏ này<% } else if (freeShip) { %>Phí giao đồng giá <%= money(s.shipping_fee) %> · miễn phí từ <%= money(freeShip) %><% } %></span>
      </p>

      <% if (product.stock > 0) { %>
      <form action="/gio-hang/them" method="post" data-add-to-cart data-keep-on-page id="buy-form" data-track-id="<%= product.id %>" data-track-name="<%= product.name %>" data-track-price="<%= product.price %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <div class="buy-qty">
          <span class="buy-qty-label" id="qty-label">Số lượng</span>
          <div class="qty" data-qty>
            <button type="button" aria-label="Giảm số lượng" data-step="-1"><svg class="icon icon-sm"><use href="#i-minus"/></svg></button>
            <label class="sr-only" for="qty">Số lượng</label>
            <input id="qty" name="qty" type="number" inputmode="numeric" min="1" max="<%= Math.min(product.stock, 500) %>" value="1">
            <button type="button" aria-label="Tăng số lượng" data-step="1"><svg class="icon icon-sm"><use href="#i-plus"/></svg></button>
          </div>
        </div>
        <div class="buy-stack">
          <button class="btn btn-lg btn-block" type="submit" name="buy_now" value="1" data-no-ajax>Mua ngay</button>
          <button class="btn btn-lg btn-ghost btn-block" type="submit"><svg class="icon"><use href="#i-bag"/></svg> Thêm vào giỏ</button>
        </div>
      </form>
      <% const askProduct = `Lunar Lucky ơi, mình đang xem giỏ ${product.name} (${money(product.price)}) và muốn hỏi thêm: ${siteUrl}/san-pham/${product.slug}`; %>
      <a class="btn btn-quiet btn-block buy-ask" href="<%= s.zalo_url %>" target="_blank" rel="noopener" data-ask="<%= askProduct %>"><svg class="icon"><use href="#i-chat"/></svg> Hỏi về giỏ này qua Zalo</a>
      <% if (s.messenger_url) { %><p class="buy-ask-note small muted">Dùng Facebook? <a href="<%= s.messenger_url %>?text=<%= encodeURIComponent(askProduct) %>" target="_blank" rel="noopener">Nhắn Messenger</a></p><% } %>
      <div class="buy-bar" data-buy-bar aria-hidden="true">
        <div class="buy-bar-info"><span><%= product.name %></span><b><%= money(product.price) %></b></div>
        <button class="btn" type="submit" form="buy-form" name="buy_now" value="1" data-no-ajax tabindex="-1">Mua ngay</button>
      </div>
      <p class="stock-note <%= product.stock <= 5 ? 'low' : '' %>">
        <svg class="icon icon-sm"><use href="#i-<%= product.stock <= 5 ? 'alert' : 'check' %>"/></svg>
        <%= product.stock <= 5 ? `Chỉ còn ${product.stock} giỏ, đặt sớm để giữ hàng` : 'Còn hàng, sẵn sàng giao' %>
      </p>
      <p class="buy-terms small muted">Thanh toán qua VietQR / chuyển khoản hoặc COD. Đơn COD cần đặt cọc để giữ hàng: <%= depositText %>; phần còn lại trả khi nhận.</p>
      <% } else { %>
        <div class="flash flash-info"><svg class="icon"><use href="#i-info"/></svg><span>Mẫu giỏ này tạm hết hàng. Nhắn Lunar Lucky để được báo khi có hàng hoặc gợi ý mẫu tương tự.</span></div>
        <div class="buy-row"><a class="btn btn-lg" href="<%= s.zalo_url %>" target="_blank" rel="noopener" data-ask="Lunar Lucky ơi, mình muốn hỏi giỏ <%= product.name %> khi nào có hàng lại? <%= siteUrl %>/san-pham/<%= product.slug %>">Nhắn Zalo tư vấn</a></div>
        <%- include('../partials/callback', { source: 'san-pham', productId: product.id, title: 'Muốn được báo khi có hàng?' }) %>
      <% } %>
    </div>
  </div>

  <section class="pdp-details" aria-label="Thông tin chi tiết giỏ quà">
    <details class="pdp-acc" open>
      <summary>Thành phần giỏ quà</summary>
      <div class="pdp-acc-body">
        <% if (contents.length) { %>
        <ul class="contents-grid"><% contents.forEach(c => { %><li><%= c %></li><% }) %></ul>
        <% } %>
        <% if (descriptionHtml && descriptionHtml.trim()) { %><div class="prose pdp-desc"><%- descriptionHtml %></div><% } %>
        <p class="pdp-note">Hạn dùng tối thiểu 3 tháng tính từ ngày giao.</p>
      </div>
    </details>
    <details class="pdp-acc">
      <summary>Giao hàng &amp; thanh toán</summary>
      <div class="pdp-acc-body">
        <ul class="pdp-list">
          <li><b>Nội thành Hà Nội:</b> giao đúng ngày bạn chọn, chọn được buổi sáng / chiều / tối.</li>
          <li><b>Tỉnh khác:</b> 2–4 ngày, báo ngày dự kiến khi xác nhận đơn.</li>
          <li>Phí giao đồng giá <%= money(s.shipping_fee) %>, miễn phí cho đơn từ <%= money(s.free_ship_threshold) %>. Kèm ảnh xác nhận khi quà tới tay.</li>
          <li>Thanh toán qua VietQR / chuyển khoản (hệ thống tự xác nhận khi tiền về) hoặc COD. Đơn COD cần đặt cọc để giữ hàng: <%= depositText %>; phần còn lại trả khi nhận.</li>
          <li>Gửi tặng trực tiếp, không kèm hóa đơn giá tiền.</li>
        </ul>
        <p class="small"><a href="/chinh-sach-giao-hang">Xem đầy đủ chính sách giao hàng</a></p>
      </div>
    </details>
    <details class="pdp-acc">
      <summary>Đổi trả &amp; hỗ trợ</summary>
      <div class="pdp-acc-body">
        <dl class="pdp-qa">
          <dt>Trường hợp nào được đổi?</dt><dd>Giỏ vỡ, móp, hư hỏng khi vận chuyển; giao sai mẫu hoặc thiếu món; sản phẩm hết hạn hoặc có dấu hiệu hư hỏng. Hư hỏng khi nhận: đổi mới trong 24 giờ. Đổi ý khi giỏ còn nguyên vẹn, đúng mẫu thì không áp dụng đổi trả.</dd>
          <dt>Cần gửi ảnh và liên hệ trong bao lâu?</dt><dd>Trong <b>24 giờ</b> kể từ khi nhận. Bạn nên quay video khi mở giỏ, rồi gửi mã đơn kèm ảnh/video qua Zalo, hotline <%= s.shop_phone %> hoặc email. Lunar Lucky phản hồi trong ngày.</dd>
          <dt>Ai chịu phí khi lỗi do shop hoặc vận chuyển?</dt><dd>Lunar Lucky chịu. Bạn được đổi giỏ mới tương đương, giao bổ sung miễn phí, hoặc hoàn tiền phần món bị lỗi qua chuyển khoản trong 3 ngày làm việc.</dd>
          <dt>Giỏ giao trực tiếp cho người nhận quà thì sao?</dt><dd>Người nhận cứ quay video khi mở giỏ và gửi ảnh/video cho bạn (hoặc nhắn thẳng Lunar Lucky). Bạn báo mã đơn trong 24 giờ kể từ lúc quà tới tay. Lunar Lucky xử lý với bạn, người nhận không phải trả khoản nào.</dd>
        </dl>
        <p class="small"><a href="/chinh-sach-doi-tra">Xem đầy đủ chính sách đổi trả</a></p>
      </div>
    </details>
  </section>

  <% if (reviews && reviews.length) { %>
  <section class="section-tight" style="border-top:1px solid var(--line)" aria-labelledby="pr-reviews">
    <div class="section-head"><div class="stack"><span class="eyebrow">Ảnh thật lúc giao</span><h2 class="h2" id="pr-reviews">Khách đã nhận <em><%= product.name %></em></h2></div></div>
    <%- include('../partials/reviews', { reviews }) %>
  </section>
  <% } %>

  <% if (related.length) { %>
  <section class="section" style="border-top:1px solid var(--line)">
    <div class="section-head"><div class="stack"><span class="eyebrow">Có thể bạn thích</span><h2 class="h2">Giỏ quà <em>tương tự</em></h2></div></div>
    <div class="product-grid cols-4">
      <% related.forEach((p, i) => { %><%- include('../partials/product-card', { p, i }) %><% }) %>
    </div>
  </section>
  <% } %>
</div>
<%- include('../partials/bottom') %>
