<%- include('../partials/top') %>
<% const save = product.compare_price && product.compare_price > product.price ? Math.round((1 - product.price / product.compare_price) * 100) : 0; %>
<div class="container">
  <ol class="crumbs" aria-label="Breadcrumb" style="padding-top:24px">
    <li><a href="/">Trang chủ</a></li>
    <li><a href="/bo-suu-tap">Bộ sưu tập</a></li>
    <% if (category) { %><li><a href="/bo-suu-tap/<%= category.slug %>"><%= category.name %></a></li><% } %>
    <li aria-current="page"><%= product.name %></li>
  </ol>

  <div class="pdp">
    <div class="pdp-gallery" data-gallery>
      <div class="gallery-main">
        <img src="<%= img(gallery[0]) %>" alt="<%= product.name %>" width="800" height="1000" fetchpriority="high" data-gallery-main>
      </div>
      <% if (gallery.length > 1) { %>
      <ul class="thumbs" aria-label="Ảnh sản phẩm">
        <% gallery.forEach((id, i) => { %>
          <li><button type="button" aria-label="Xem ảnh <%= i + 1 %>" aria-current="<%= i === 0 %>" data-src="<%= img(id) %>"><img src="<%= img(id) %>" alt="" loading="lazy" width="76" height="92"></button></li>
        <% }) %>
      </ul>
      <% } %>
    </div>

    <div class="pdp-info">
      <% if (category) { %><a class="eyebrow" href="/bo-suu-tap/<%= category.slug %>"><%= category.name %></a><% } %>
      <h1><%= product.name %></h1>
      <div class="price">
        <span><%= money(product.price) %></span>
        <% if (save) { %><del><%= money(product.compare_price) %></del><span class="save">Tiết kiệm <%= save %>%</span><% } %>
      </div>
      <% const freeShip = Number(s.free_ship_threshold) || 0; %>
      <p class="ship-promise">
        <svg class="icon icon-sm"><use href="#i-truck"/></svg>
        <span>Giao từ <b><%= earliest.slice(8) %>/<%= earliest.slice(5, 7) %></b> tại Hà Nội · tỉnh khác 2–4 ngày<br>
        <% if (orderDeadline) { %>Giao quà Tết đến hết <b><%= orderDeadline %></b><br><% } %>
        <% if (freeShip && product.price >= freeShip) { %><b style="color:var(--jade-700)">Miễn phí giao hàng</b> cho giỏ này<% } else if (freeShip) { %>Miễn phí giao cho đơn từ <%= money(freeShip) %><% } %></span>
      </p>
      <% if (product.short_desc) { %><p class="short"><%= product.short_desc %></p><% } %>

      <% if (contents.length) { %>
      <div class="contents">
        <h2>Trong giỏ quà có</h2>
        <ul><% contents.forEach(c => { %><li><%= c %></li><% }) %></ul>
      </div>
      <% } %>

      <% if (product.stock > 0) { %>
      <form action="/gio-hang/them" method="post" data-add-to-cart data-keep-on-page id="buy-form" data-track-id="<%= product.id %>" data-track-name="<%= product.name %>" data-track-price="<%= product.price %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <div class="buy-row">
          <div class="qty" data-qty>
            <button type="button" aria-label="Giảm số lượng" data-step="-1"><svg class="icon icon-sm"><use href="#i-minus"/></svg></button>
            <label class="sr-only" for="qty">Số lượng</label>
            <input id="qty" name="qty" type="number" inputmode="numeric" min="1" max="<%= Math.min(product.stock, 500) %>" value="1">
            <button type="button" aria-label="Tăng số lượng" data-step="1"><svg class="icon icon-sm"><use href="#i-plus"/></svg></button>
          </div>
          <button class="btn btn-lg" type="submit"><svg class="icon"><use href="#i-bag"/></svg> Thêm vào giỏ</button>
          <button class="btn btn-lg btn-ghost" type="submit" name="buy_now" value="1" data-no-ajax>Mua ngay</button>
        </div>
      </form>
      <div class="buy-bar" data-buy-bar aria-hidden="true">
        <div class="buy-bar-info"><span><%= product.name %></span><b><%= money(product.price) %></b></div>
        <button class="btn" type="submit" form="buy-form" name="buy_now" value="1" data-no-ajax tabindex="-1">Mua ngay</button>
      </div>
      <p class="stock-note <%= product.stock <= 5 ? 'low' : '' %>">
        <svg class="icon icon-sm"><use href="#i-<%= product.stock <= 5 ? 'alert' : 'check' %>"/></svg>
        <%= product.stock <= 5 ? `Chỉ còn ${product.stock} giỏ, đặt sớm để giữ hàng` : 'Còn hàng, sẵn sàng giao' %>
      </p>
      <%- include('../partials/callback', { source: 'san-pham', productId: product.id }) %>
      <% } else { %>
        <div class="flash flash-info"><svg class="icon"><use href="#i-info"/></svg><span>Mẫu giỏ này tạm hết hàng. Nhắn Lunar Lucky để được báo khi có hàng hoặc gợi ý mẫu tương tự.</span></div>
        <div class="buy-row"><a class="btn btn-lg" href="<%= s.zalo_url %>" target="_blank" rel="noopener" data-ask="Lunar Lucky ơi, mình muốn hỏi giỏ <%= product.name %> khi nào có hàng lại? <%= siteUrl %>/san-pham/<%= product.slug %>">Nhắn Zalo tư vấn</a></div>
        <%- include('../partials/callback', { source: 'san-pham', productId: product.id, title: 'Muốn được báo khi có hàng?' }) %>
      <% } %>

      <ul class="assure">
        <li><svg class="icon"><use href="#i-leaf"/></svg> Hạn dùng tối thiểu 3 tháng tính từ ngày giao</li>
        <li><svg class="icon"><use href="#i-calendar"/></svg> Chọn ngày & buổi giao, kèm ảnh khi quà tới tay</li>
        <li><svg class="icon"><use href="#i-shield"/></svg> Hư hỏng khi nhận: đổi mới trong 24 giờ</li>
        <li><svg class="icon"><use href="#i-gift"/></svg> Gửi tặng trực tiếp, không kèm hóa đơn giá tiền</li>
        <li><svg class="icon"><use href="#i-chat"/></svg> <span>Cần tư vấn? <a href="<%= s.zalo_url %>" target="_blank" rel="noopener" style="color:var(--primary);font-weight:600" data-ask="Lunar Lucky ơi, mình muốn hỏi về <%= product.name %> (<%= money(product.price) %>): <%= siteUrl %>/san-pham/<%= product.slug %>">Hỏi nhanh qua Zalo</a><% if (s.messenger_url) { %> · <a href="<%= s.messenger_url %>?text=<%= encodeURIComponent('Mình muốn hỏi về ' + product.name + ' ' + siteUrl + '/san-pham/' + product.slug) %>" target="_blank" rel="noopener" style="color:var(--primary);font-weight:600">Messenger</a><% } %></span></li>
      </ul>
      <% const askCustom = `Lunar Lucky ơi, mình muốn đặt ${product.name} (${money(product.price)}) nhưng đổi một vài món trong giỏ: … Shop tư vấn giúp mình nhé. ${siteUrl}/san-pham/${product.slug}`; %>
      <div class="custom-box">
        <strong><svg class="icon icon-sm"><use href="#i-sparkle"/></svg> Muốn đổi món trong giỏ?</strong>
        <p>Chọn giỏ gần ý bạn nhất rồi nhắn Lunar Lucky — chuyên viên tư vấn đổi món theo hàng đang có và báo giá ngay.</p>
        <div class="custom-actions">
          <a class="btn btn-sm" href="<%= s.zalo_url %>" target="_blank" rel="noopener" data-ask="<%= askCustom %>">Nhắn Zalo đổi món</a>
          <% if (s.messenger_url) { %><a class="btn btn-sm btn-quiet" href="<%= s.messenger_url %>?text=<%= encodeURIComponent(askCustom) %>" target="_blank" rel="noopener">Nhắn Fanpage</a><% } %>
        </div>
      </div>
    </div>
  </div>

  <% if (descriptionHtml && descriptionHtml.trim()) { %>
  <section class="section-tight" style="border-top:1px solid var(--line)">
    <div class="split" style="align-items:start">
      <div><span class="eyebrow">Câu chuyện giỏ quà</span><h2 class="h2" style="margin-top:12px">Về <em><%= product.name %></em></h2></div>
      <div class="prose"><%- descriptionHtml %></div>
    </div>
  </section>
  <% } %>

  <% if (reviews && reviews.length) { %>
  <section class="section-tight" style="border-top:1px solid var(--line)" aria-labelledby="pr-reviews">
    <div class="section-head"><div class="stack"><span class="eyebrow">Ảnh thật lúc giao</span><h2 class="h2" id="pr-reviews">Khách đã nhận <em><%= product.name %></em></h2></div></div>
    <%- include('../partials/reviews', { reviews }) %>
  </section>
  <% } %>

  <% if (related.length) { %>
  <section class="section" style="border-top:1px solid var(--line)">
    <div class="section-head"><div class="stack"><span class="eyebrow">Có thể bạn thích</span><h2 class="h2">Giỏ quà <em>tương tự</em></h2></div></div>
    <div class="product-grid cols-4">
      <% related.forEach((p, i) => { %><%- include('../partials/product-card', { p, i }) %><% }) %>
    </div>
  </section>
  <% } %>
</div>
<%- include('../partials/bottom') %>
