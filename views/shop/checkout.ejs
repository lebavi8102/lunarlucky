<%- include('../partials/top') %>
<section class="page-head">
  <div class="container">
    <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/gio-hang">Giỏ hàng</a></li><li aria-current="page">Thanh toán</li></ol>
    <h1>Hoàn tất đơn quà</h1>
  </div>
</section>

<div class="container">
  <% if (Object.keys(errors).length) { %>
    <div class="flash flash-error" role="alert" tabindex="-1" data-focus-on-load>
      <svg class="icon"><use href="#i-alert"/></svg>
      <span>Vui lòng kiểm tra lại <%= Object.keys(errors).length %> thông tin được đánh dấu bên dưới.</span>
    </div>
  <% } %>

  <form class="cart-layout" action="/thanh-toan" method="post" novalidate data-checkout>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="cart_snapshot" value="<%= JSON.stringify(cart.lines.filter(l => l.productId).map(l => ({ id: l.productId, qty: l.qty }))) %>">
    <div>
      <fieldset class="fieldset">
        <legend><span class="num">1</span> Thông tin người đặt</legend>
        <%- include('../partials/field', { name: 'customer_name', label: 'Họ và tên', required: true, autocomplete: 'name', maxlength: 120 }) %>
        <div class="grid-2" style="margin-top:16px">
          <%- include('../partials/field', { name: 'phone', label: 'Số điện thoại', type: 'tel', required: true, autocomplete: 'tel', inputmode: 'tel', placeholder: '0912 345 678' }) %>
          <%- include('../partials/field', { name: 'email', label: 'Email', type: 'email', optional: true, autocomplete: 'email', help: 'Để nhận xác nhận đơn hàng.' }) %>
        </div>
        <p class="small muted remember-note" data-remember-note hidden>✓ Đã điền sẵn thông tin lần trước. <button type="button" class="link-btn" data-remember-clear>Xóa</button></p>
      </fieldset>

      <fieldset class="fieldset">
        <legend><span class="num">2</span> Giao hàng</legend>
        <label class="check" style="margin-bottom:16px;padding:14px 16px;background:var(--cream-100);border-radius:12px">
          <input type="checkbox" name="is_gift" value="1" <%= values.is_gift ? 'checked' : '' %> data-gift-toggle>
          <span><b>Gửi tặng trực tiếp cho người khác</b><br><span class="small muted">Lunar Lucky giao đến người nhận, không kèm hóa đơn giá tiền. Đơn gửi tặng thanh toán chuyển khoản trước để người nhận không phải trả tiền.</span></span>
        </label>

        <%- include('../partials/field', { name: 'province', label: 'Giao đến Tỉnh / Thành phố', as: 'select', required: true, options: provinces }) %>
        <p class="small muted" style="margin-top:8px">Phí giao đồng giá <%= money(s.shipping_fee) %>, <b>miễn phí cho đơn từ <%= money(s.free_ship_threshold) %></b>. Nội thành Hà Nội giao đúng ngày bạn chọn; tỉnh khác 2–4 ngày.</p>
        <div data-buyer-address <%= values.is_gift ? 'hidden' : '' %> style="margin-top:16px">
          <%- include('../partials/field', { name: 'address', label: 'Địa chỉ nhận hàng', required: true, autocomplete: 'street-address', placeholder: 'Số nhà, đường, phường/xã', maxlength: 255 }) %>
        </div>

        <div data-gift-fields <%= values.is_gift ? '' : 'hidden' %> style="margin-top:20px;padding-top:20px;border-top:1px dashed var(--line)">
          <p class="label" style="margin-bottom:12px">Thông tin người nhận quà</p>
          <div class="grid-2">
            <%- include('../partials/field', { name: 'recipient_name', label: 'Tên người nhận', maxlength: 120 }) %>
            <%- include('../partials/field', { name: 'recipient_phone', label: 'SĐT người nhận', type: 'tel', inputmode: 'tel' }) %>
          </div>
          <div style="margin-top:16px"><%- include('../partials/field', { name: 'recipient_address', label: 'Địa chỉ người nhận', placeholder: 'Số nhà, đường, phường/xã', maxlength: 255 }) %></div>
        </div>

        <div style="margin-top:16px">
          <p class="label" style="margin-bottom:8px">Ngày giao mong muốn</p>
          <div class="date-picks" role="group" aria-label="Chọn nhanh ngày giao">
            <% const wd = (d) => ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'][new Date(d + 'T00:00:00Z').getUTCDay()]; %>
            <% (quickDates || []).forEach((d, i) => { %>
              <button type="button" class="date-pick" data-date-pick="<%= d %>" aria-pressed="<%= values.delivery_date === d %>">
                <b><%= i === 0 ? 'Sớm nhất' : wd(d) %></b><span><%= d.slice(8) %>/<%= d.slice(5, 7) %></span>
              </button>
            <% }) %>
            <button type="button" class="date-pick" data-date-other aria-pressed="<%= !!(values.delivery_date && !(quickDates || []).includes(values.delivery_date)) %>"><b>Ngày khác</b><span>Chọn lịch</span></button>
          </div>
          <div data-date-input style="margin-top:10px" <%= values.delivery_date && (quickDates || []).includes(values.delivery_date) && !errors.delivery_date ? 'hidden' : '' %>>
            <%- include('../partials/field', { name: 'delivery_date', label: 'Chọn ngày giao', type: 'date', required: true, min: minDate, max: maxDate }) %>
          </div>
          <p class="help" style="margin-top:6px">Giao trong khung 8:00 – 20:00, Lunar Lucky gọi trước khi giao.</p>
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <legend><span class="num">3</span> Thiệp &amp; lời nhắn</legend>
        <p class="small muted" style="margin:-4px 0 10px">Bấm chọn một lời chúc có sẵn, hoặc tự viết. Có thể để trống.</p>
        <ul class="chips wish-picks" style="margin-bottom:12px">
          <% ['An Khang Thịnh Vượng – Vạn Sự Như Ý!', 'Kính chúc gia đình năm mới sức khỏe, bình an và hạnh phúc!', 'Cảm ơn Quý đối tác đã đồng hành. Chúc năm mới phát tài phát lộc!', 'Chúc năm mới an khang, mọi điều như ý!'].forEach(w => { %>
            <li><button type="button" class="chip" data-wish="<%= w %>"><%= w.length > 34 ? w.slice(0, 32) + '…' : w %></button></li>
          <% }) %>
        </ul>
        <%- include('../partials/field', { name: 'card_message', label: 'Lời chúc trên thiệp', as: 'textarea', optional: true, maxlength: 300, placeholder: 'VD: Kính chúc gia đình chú Hai một năm mới An Khang Thịnh Vượng!', help: 'Lunar Lucky viết tay lời chúc này lên thiệp.' }) %>
        <details class="more-note" style="margin-top:14px" <%= values.note ? 'open' : '' %>>
          <summary>＋ Thêm ghi chú cho Lunar Lucky</summary>
          <div style="margin-top:10px"><%- include('../partials/field', { name: 'note', label: 'Ghi chú', as: 'textarea', optional: true, maxlength: 500, placeholder: 'VD: giao giờ hành chính, gọi trước 30 phút…' }) %></div>
        </details>
      </fieldset>

      <fieldset class="fieldset">
        <legend><span class="num">4</span> Thanh toán</legend>
        <label class="check" style="margin-bottom:16px;padding:14px 16px;background:var(--cream-100);border-radius:12px">
          <input type="checkbox" name="needs_vat" value="1" <%= values.needs_vat ? 'checked' : '' %> data-vat-toggle>
          <span><b>Tôi cần xuất hóa đơn VAT</b> <span class="small muted">(+<%= vatPercent %>% phí xuất hóa đơn)</span><br><span class="small muted">Dành cho doanh nghiệp, thanh toán bằng chuyển khoản.</span></span>
        </label>
        <div class="flash flash-info" data-vat-notice <%= values.needs_vat ? '' : 'hidden' %> style="margin:0 0 16px">
          <svg class="icon"><use href="#i-file"/></svg>
          <span>
            <b>Về hóa đơn VAT:</b> hóa đơn được xuất qua đơn vị đối tác của Lunar Lucky.
            Khách hàng chịu <b>phí xuất hóa đơn <%= vatPercent %>%</b> trên giá trị đơn (tiền hàng sau giảm giá, không tính phí giao).
            Phí này <b>đã được cộng vào số tiền cần thanh toán</b>.
            Đơn xuất VAT thanh toán bằng chuyển khoản; hóa đơn điện tử gửi về email bạn cung cấp.
            <% const vf = Math.round((cart.subtotal - cart.discount) * vatPercent / 100); %>
            <% if (s.zalo_url) { %><span style="display:block;margin-top:8px">Doanh nghiệp cần chuyển khoản vào tài khoản công ty xuất hóa đơn? <a href="<%= s.zalo_url %>" target="_blank" rel="noopener" style="text-decoration:underline;font-weight:600">Nhắn Zalo Lunar Lucky</a> để nhận thông tin.</span><% } %>
            <span style="display:block;margin-top:8px" data-vat-breakdown>Tiền hàng <%= money(cart.subtotal - cart.discount) %><% if (cart.shippingFee) { %> + phí giao <%= money(cart.shippingFee) %><% } %> + phí VAT <%= money(vf) %> = <b style="color:var(--lacquer-700)">Cần thanh toán <%= money(cart.total + vf) %></b></span>
          </span>
        </div>
        <div data-vat-fields <%= values.needs_vat ? '' : 'hidden' %> style="margin-bottom:20px">
          <%- include('../partials/field', { name: 'vat_company', label: 'Tên công ty', autocomplete: 'organization', maxlength: 200 }) %>
          <div class="grid-2" style="margin-top:16px">
            <%- include('../partials/field', { name: 'vat_tax_code', label: 'Mã số thuế', inputmode: 'numeric', maxlength: 20, placeholder: '0123456789' }) %>
            <%- include('../partials/field', { name: 'vat_email', label: 'Email nhận hóa đơn', type: 'email', autocomplete: 'email' }) %>
          </div>
          <div style="margin-top:16px"><%- include('../partials/field', { name: 'vat_address', label: 'Địa chỉ công ty (theo đăng ký kinh doanh)', maxlength: 255 }) %></div>
        </div>
        <div class="radio-cards">
          <label class="radio-card">
            <input type="radio" name="payment_method" value="bank" <%= values.payment_method !== 'cod' ? 'checked' : '' %>>
            <span class="dot"></span>
            <span><strong>Chuyển khoản VietQR <span style="margin-left:6px;padding:2px 8px;border-radius:999px;background:var(--lacquer-700);color:#fff;font-size:11px;font-weight:600;vertical-align:middle;white-space:nowrap;display:inline-block">Khuyên dùng</span></strong><span>Quét mã QR sau khi đặt — nhận tiền là chuẩn bị &amp; giao ngay</span></span>
          </label>
          <label class="radio-card" data-cod-option <%= values.needs_vat || values.is_gift ? 'hidden' : '' %>>
            <input type="radio" name="payment_method" value="cod" <%= values.payment_method === 'cod' && !values.needs_vat ? 'checked' : '' %>>
            <span class="dot"></span>
            <span><strong>Thanh toán khi nhận hàng (COD)</strong><span>Trả tiền mặt khi nhận; Lunar Lucky gọi xác nhận trước khi giao</span></span>
          </label>
        </div>
      </fieldset>
    </div>

    <aside class="summary card" aria-label="Đơn hàng của bạn">
      <h2>Đơn hàng</h2>
      <% if (cart.notices && cart.notices.length) { %><p class="small" style="color:var(--lacquer-700);margin:-8px 0 12px"><%= cart.notices.join(' ') %></p><% } %>
      <ul class="summary-items" data-summary-items>
        <% cart.lines.forEach(l => { %>
        <li data-line="<%= l.key %>">
          <span class="thumb"><img src="<%= img(l.image_id) %>" alt="" width="60" height="75" loading="lazy"><span class="q"><%= l.qty %></span></span>
          <span class="s-info">
            <span class="s-name"><%= l.name %></span>
            <span class="s-ctrl">
              <span class="qty xs" data-qty>
                <button type="button" aria-label="Giảm số lượng <%= l.name %>" data-step="-1"><svg class="icon icon-sm"><use href="#i-minus"/></svg></button>
                <input type="number" inputmode="numeric" min="1" max="<%= l.maxQty %>" value="<%= l.qty %>" aria-label="Số lượng <%= l.name %>" data-checkout-qty="<%= l.key %>">
                <button type="button" aria-label="Tăng số lượng <%= l.name %>" data-step="1"><svg class="icon icon-sm"><use href="#i-plus"/></svg></button>
              </span>
              <button type="button" class="s-remove" data-checkout-remove="<%= l.key %>" aria-label="Xóa <%= l.name %> khỏi đơn"><svg class="icon icon-sm"><use href="#i-trash"/></svg></button>
            </span>
          </span>
          <span class="line-total"><%= money(l.lineTotal) %></span>
        </li>
        <% }) %>
      </ul>
      <div class="sum-row"><span>Tạm tính</span><span><%= money(cart.subtotal) %></span></div>
      <% if (cart.discount) { %><div class="sum-row"><span>Mã <%= cart.coupon.code %> <button type="button" class="link-btn small" data-coupon-remove>Bỏ mã</button></span><span class="disc">−<%= money(cart.discount) %></span></div><% } else { %>
      <details class="coupon-box" <%= cart.couponError ? 'open' : '' %>>
        <summary>Có mã giảm giá?</summary>
        <div class="coupon-inline">
          <label class="sr-only" for="ck-coupon">Mã giảm giá</label>
          <input class="input" id="ck-coupon" placeholder="Nhập mã" autocomplete="off" maxlength="40" data-coupon-input>
          <button type="button" class="btn btn-sm" data-coupon-apply>Áp dụng</button>
        </div>
        <p class="small" role="status" aria-live="polite" data-coupon-msg style="color:var(--lacquer-700);margin-top:6px"><%= cart.couponError || '' %></p>
      </details>
      <% } %>
      <div class="sum-row"><span>Phí giao hàng</span><span><%= cart.shippingFee ? money(cart.shippingFee) : 'Miễn phí' %></span></div>
      <% const vatFeePreview = Math.round((cart.subtotal - cart.discount) * vatPercent / 100); %>
      <div class="sum-row" data-vat-row <%= values.needs_vat ? '' : 'hidden' %>><span>Phí xuất hóa đơn VAT (<%= vatPercent %>%)</span><span><%= money(vatFeePreview) %></span></div>
      <div class="sum-row total"><span>Tổng cộng</span><span data-total data-base="<%= cart.total %>" data-with-vat="<%= cart.total + vatFeePreview %>"><%= money(values.needs_vat ? cart.total + vatFeePreview : cart.total) %></span></div>
      <button class="btn btn-lg btn-block" type="submit" style="margin-top:20px" data-submit>Đặt hàng</button>
      <p class="tiny muted" style="margin-top:12px;text-align:center">Khi đặt hàng, bạn đồng ý với <a href="/dieu-khoan" style="text-decoration:underline">điều khoản</a> và <a href="/chinh-sach-bao-mat" style="text-decoration:underline">chính sách bảo mật</a> của Lunar Lucky.</p>
    </aside>
  </form>
  <div style="max-width:720px;margin:24px 0 0">
    <%- include('../partials/callback', { source: 'thanh-toan', title: 'Ngại điền thông tin? Để Lunar Lucky gọi cho bạn' }) %>
  </div>
</div>
<%- include('../partials/bottom') %>
