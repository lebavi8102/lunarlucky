<%- include('../partials/top') %>
<% const steps = [['new','Đã đặt'],['confirmed','Xác nhận'],['packing','Đóng gói'],['shipping','Đang giao'],['completed','Hoàn tất']];
   const idx = steps.findIndex(x => x[0] === order.status);
   const cancelled = order.status === 'cancelled';
   const needPay = pay.awaitingMoney(order); // chuyển khoản chưa trả, hoặc COD chờ cọc
   const isDeposit = needPay && order.payment_method === 'cod';
   const due = pay.amountDue(order);
   const codQr = order.payment_method === 'cod' && !needPay && order.payment_status !== 'paid' && !cancelled && qr;
   const justPaid = ['paid', 'deposit'].includes(order.payment_status) && !cancelled && order.status === 'new'; %>
<div class="container" style="max-width:920px">
  <div class="order-hero">
    <div class="seal"><svg class="icon"><use href="#i-<%= cancelled ? 'x' : 'check' %>"/></svg></div>
    <span class="eyebrow center"><%= isNew ? 'Đặt hàng thành công' : 'Chi tiết đơn hàng' %></span>
    <h1 class="h2" style="margin-top:12px"><%= isNew ? `Cảm ơn ${order.customer_name}!` : (cancelled ? 'Đơn hàng đã hủy' : 'Đơn quà của bạn') %></h1>
    <% if (isNew) { %><p class="lead" style="margin:16px auto 0"><%= isDeposit ? 'Đơn sẽ được giữ và chuẩn bị ngay khi Lunar Lucky nhận được tiền cọc.' : needPay ? 'Đơn sẽ được chuẩn bị và giao ngay khi Lunar Lucky nhận được chuyển khoản.' : 'Lunar Lucky sẽ gọi xác nhận trước khi giao.' %> <%= order.email ? 'Thông tin đơn đã được gửi đến ' + order.email + '.' : '' %></p><% } %>
    <div class="order-code">Mã đơn: <span data-copy-text><%= order.code %></span>
      <button type="button" class="copy-btn" data-copy="<%= order.code %>"><svg class="icon icon-sm"><use href="#i-copy"/></svg> Sao chép</button>
    </div>
    <% if (isNew && s.zalo_url) { %>
      <p class="small" style="margin-top:14px"><a href="<%= s.zalo_url %>" target="_blank" rel="noopener" data-ask="Lunar Lucky ơi, mình vừa đặt đơn <%= order.code %> (<%= money(order.total) %>), nhờ shop kiểm tra giúp." style="color:var(--primary);font-weight:600;text-decoration:underline">Nhắn Zalo cho shop kèm mã đơn</a> · <span class="muted">chụp màn hình trang này để lưu mã đơn</span></p>
    <% } %>
  </div>

  <% if (staffShare) { const msg = `Lunar Lucky gửi ${order.customer_name} đơn quà ${order.code} (${money(order.total)}). Xem đơn${pay.awaitingMoney(order) ? ' và mã QR thanh toán' : ''} tại: ${staffShare}`; %>
  <section class="card card-cream" style="margin-bottom:24px">
    <h2 class="h3">Gửi đơn cho khách</h2>
    <p class="small muted" style="margin:6px 0 12px">Dán tin này vào Zalo / Messenger của khách. Khách bấm link là xem được đơn<%= pay.awaitingMoney(order) ? ', mã QR và số tiền cần chuyển' : '' %> (không cần tra cứu).</p>
    <textarea class="textarea" readonly rows="3" style="font-size:14px"><%= msg %></textarea>
    <div class="hero-cta" style="margin-top:12px"><button type="button" class="btn btn-sm" data-copy="<%= msg %>">Sao chép tin nhắn</button><button type="button" class="btn btn-sm btn-quiet" data-copy="<%= staffShare %>">Chỉ sao chép link</button><a class="btn btn-sm btn-quiet" href="/bo-suu-tap">Đặt đơn khác</a></div>
  </section>
  <% } %>

  <% if (justPaid) { %>
  <div class="flash flash-success" role="status" style="margin-bottom:24px"><svg class="icon"><use href="#i-check"/></svg><span><% if (order.payment_status === 'deposit') { %><b>Đã nhận cọc <%= money(order.deposit_amount) %>.</b> Lunar Lucky đang chuẩn bị đơn quà. Bạn thanh toán <b><%= money(order.total - order.deposit_amount) %></b> khi nhận hàng.<% } else { %><b>Đã nhận thanh toán <%= money(order.total) %>.</b> Lunar Lucky đang chuẩn bị đơn quà của bạn.<% } %></span></div>
  <% } %>

  <% if ((needPay || codQr) && qr) { %>
  <section class="qr-card" aria-labelledby="pay-title" <% if (autoConfirm) { %>data-pay-poll="/don-hang/<%= order.code %>/thanh-toan"<% } %>>
    <img src="<%= qr %>" alt="Mã VietQR chuyển khoản <%= money(due) %> cho đơn <%= order.code %>" width="260" height="300">
    <div>
      <h2 id="pay-title" class="h3"><%= isDeposit ? `Đặt cọc ${money(due)} để giữ đơn` : codQr ? 'Muốn chuyển khoản trước?' : 'Quét mã để thanh toán' %></h2>
      <% if (isDeposit) { %><p class="small" style="margin:6px 0 0">Đơn từ <%= pay.depositRule(s).minQty %> giỏ hoặc trên <%= money(pay.depositRule(s).minTotal) %> cần cọc <%= pay.depositRule(s).percent %>% để Lunar Lucky giữ hàng và viết thiệp riêng cho bạn. <b>Phần còn lại <%= money(order.total - order.deposit_amount) %> trả khi nhận hàng.</b> Hoàn cọc 100% nếu shop không giao được.</p><% } %>
      <p class="muted small" style="margin:6px 0 12px"><%= codQr ? 'Không bắt buộc — đơn của bạn trả tiền mặt khi nhận hàng. Nếu muốn chuyển khoản trước, làm theo hướng dẫn dưới.' : 'Số tiền và nội dung chuyển khoản đã được điền sẵn trong mã QR.' %></p>
      <a class="btn btn-block" href="/don-hang/<%= order.code %>/qr.png" download="QR-<%= order.code %>.png" style="margin-bottom:10px"><svg class="icon icon-sm"><use href="#i-qr"/></svg> Lưu mã QR về máy</a>
      <ol class="pay-steps small">
        <li><b>Lưu mã QR</b> (nút trên, hoặc nhấn giữ vào ảnh QR → Lưu ảnh).</li>
        <li>Mở <b>ứng dụng ngân hàng</b> → chọn <b>Quét QR</b> → bấm biểu tượng <b>ảnh/thư viện</b> → chọn ảnh vừa lưu.</li>
        <li>Kiểm tra số tiền <b><%= money(due) %></b> rồi xác nhận chuyển.</li>
      </ol>
      <p class="tiny muted" style="margin:0 0 12px">Hoặc chuyển khoản thủ công bằng các thông tin dưới đây (bấm biểu tượng để sao chép).</p>
      <% if (needPay && autoConfirm) { %><div class="flash flash-info" style="margin:0 0 12px" data-pay-wait><svg class="icon"><use href="#i-clock"/></svg><span><b>Đang chờ thanh toán…</b> Trang tự cập nhật khi nhận được tiền (thường dưới 1 phút). Đơn được giữ hàng trong <%= holdHours %> giờ.</span></div><% } %>
      <% if (order.needs_vat) { %><div class="flash flash-info" style="margin:0 0 12px"><svg class="icon"><use href="#i-file"/></svg><span>Đơn xuất hóa đơn VAT: số tiền bên dưới đã gồm phí xuất hóa đơn. Hóa đơn điện tử sẽ gửi về <b><%= order.vat_email %></b>.<% if (s.zalo_url) { %><span style="display:block;margin-top:8px">Doanh nghiệp cần chuyển khoản vào tài khoản công ty xuất hóa đơn? <a href="<%= s.zalo_url %>" target="_blank" rel="noopener" style="text-decoration:underline;font-weight:600">Nhắn Zalo Lunar Lucky</a> để nhận thông tin.</span><% } %></span></div><% } %>
      <div class="bank-rows">
        <div class="bank-row"><span>Ngân hàng</span><b><%= payee.bankName || payee.bankId %></b></div>
        <div class="bank-row"><span>Số tài khoản</span><span style="display:flex;gap:8px;align-items:center"><b><%= payee.account %></b><button type="button" class="copy-btn" data-copy="<%= payee.account %>" aria-label="Sao chép số tài khoản"><svg class="icon icon-sm"><use href="#i-copy"/></svg></button></span></div>
        <div class="bank-row"><span>Chủ tài khoản</span><b><%= payee.holder %></b></div>
        <div class="bank-row"><span>Số tiền</span><span style="display:flex;gap:8px;align-items:center"><b style="color:var(--lacquer-700)"><%= money(due) %></b><button type="button" class="copy-btn" data-copy="<%= due %>" aria-label="Sao chép số tiền"><svg class="icon icon-sm"><use href="#i-copy"/></svg></button></span></div>
        <div class="bank-row"><span>Nội dung</span><span style="display:flex;gap:8px;align-items:center"><b><%= order.code %></b><button type="button" class="copy-btn" data-copy="<%= order.code %>" aria-label="Sao chép nội dung chuyển khoản"><svg class="icon icon-sm"><use href="#i-copy"/></svg></button></span></div>
      </div>
      <p class="small muted" style="margin-top:12px">Vui lòng giữ nguyên nội dung <b><%= order.code %></b> để Lunar Lucky đối soát nhanh.</p>
    </div>
  </section>
  <% } else if (needPay && order.needs_vat) { %>
  <section class="card" style="border-color:var(--gold-500)">
    <h2 class="h3">Thông tin chuyển khoản sẽ được gửi riêng</h2>
    <p class="muted" style="margin-top:8px">Lunar Lucky sẽ liên hệ qua số <b><%= order.phone %></b> hoặc email <b><%= order.vat_email %></b> để gửi thông tin chuyển khoản trong giờ làm việc.</p>
  </section>
  <% } %>

  <% if (!cancelled) { %>
  <section class="card" style="margin-top:24px" aria-label="Trạng thái đơn hàng">
    <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;align-items:center">
      <h2 class="h3">Trạng thái</h2>
      <span class="status status-<%= order.payment_status %>"><%= order.payment_method === 'cod' ? 'COD · ' : 'Chuyển khoản · ' %><%= { pending: 'Chưa thanh toán', paid: 'Đã thanh toán', refunded: 'Đã hoàn tiền' }[order.payment_status] %></span>
    </div>
    <ol class="timeline">
      <% steps.forEach((st, i) => { %><li class="<%= i <= idx ? 'done' : '' %>" <%- i === idx ? 'aria-current="step"' : '' %>><%= st[1] %></li><% }) %>
    </ol>
  </section>
  <% } %>

  <div class="split" style="margin-top:24px;gap:24px;align-items:start">
    <section class="card">
      <h2 class="h3" style="margin-bottom:16px">Giao hàng</h2>
      <dl class="kv">
        <dt>Người đặt</dt><dd><%= order.customer_name %> · <%= order.phone %></dd>
        <% if (order.is_gift) { %>
          <dt>Người nhận</dt><dd><%= order.recipient_name %> · <%= order.recipient_phone %></dd>
          <dt>Địa chỉ</dt><dd><%= order.recipient_address %>, <%= order.province %></dd>
        <% } else { %>
          <dt>Địa chỉ</dt><dd><%= order.address %>, <%= order.province %></dd>
        <% } %>
        <dt>Ngày giao</dt><dd><%= fmt.deliveryWhen(order) %></dd>
        <% if (order.needs_vat) { %><dt>Hóa đơn VAT</dt><dd><%= order.vat_company %><br><span class="small muted">MST <%= order.vat_tax_code %> · gửi về <%= order.vat_email %></span></dd><% } %>
        <% if (order.card_message) { %><dt>Thiệp</dt><dd class="serif" style="font-size:19px;font-style:italic">“<%= order.card_message %>”</dd><% } %>
        <% if (order.note) { %><dt>Ghi chú</dt><dd><%= order.note %></dd><% } %>
      </dl>
    </section>
    <section class="card">
      <h2 class="h3" style="margin-bottom:16px">Sản phẩm</h2>
      <ul class="summary-items" style="grid-template-columns:1fr">
        <% items.forEach(i => { %>
          <li style="grid-template-columns:1fr auto"><span><%= i.name %> × <%= i.qty %></span><span class="line-total"><%= money(i.line_total) %></span></li>
        <% }) %>
      </ul>
      <div class="sum-row"><span>Tạm tính</span><span><%= money(order.subtotal) %></span></div>
      <% if (order.discount) { %><div class="sum-row"><span>Giảm giá (<%= order.coupon_code %>)</span><span class="disc">−<%= money(order.discount) %></span></div><% } %>
      <div class="sum-row"><span>Phí giao hàng</span><span><%= order.shipping_fee ? money(order.shipping_fee) : 'Miễn phí' %></span></div>
      <% if (order.vat_fee) { %><div class="sum-row"><span>Phí xuất hóa đơn VAT<%= order.vat_fee_percent ? ' (' + Number(order.vat_fee_percent) + '%)' : '' %></span><span><%= money(order.vat_fee) %></span></div><% } %>
      <div class="sum-row total"><span>Tổng cộng</span><span><%= money(order.total) %></span></div>
      <% if (Number(order.deposit_amount) > 0) { %><div class="sum-row"><span>Đặt cọc<%= order.payment_status === 'pending' ? ' (chưa nhận)' : '' %></span><span><%= money(order.deposit_amount) %></span></div><div class="sum-row"><span>Trả khi nhận hàng</span><span><%= money(order.total - order.deposit_amount) %></span></div><% } %>
    </section>
  </div>

  <div class="hero-cta" style="justify-content:center;margin-block:48px 96px">
    <a class="btn btn-quiet" href="/bo-suu-tap">Tiếp tục mua sắm</a>
    <a class="btn btn-quiet" href="<%= s.zalo_url %>" target="_blank" rel="noopener">Cần hỗ trợ? Nhắn Zalo</a>
  </div>
</div>
<%- include('../partials/bottom') %>
