<%- include('../partials/top') %>
<% const steps = [['new','Đã đặt'],['confirmed','Xác nhận'],['packing','Đóng gói'],['shipping','Đang giao'],['completed','Hoàn tất']];
   const idx = steps.findIndex(x => x[0] === order.status);
   const cancelled = order.status === 'cancelled';
   const needPay = order.payment_method === 'bank' && order.payment_status === 'pending' && !cancelled; %>
<div class="container" style="max-width:920px">
  <div class="order-hero">
    <div class="seal"><svg class="icon"><use href="#i-<%= cancelled ? 'x' : 'check' %>"/></svg></div>
    <span class="eyebrow center"><%= isNew ? 'Đặt hàng thành công' : 'Chi tiết đơn hàng' %></span>
    <h1 class="h2" style="margin-top:12px"><%= isNew ? `Cảm ơn ${order.customer_name}!` : (cancelled ? 'Đơn hàng đã hủy' : 'Đơn quà của bạn') %></h1>
    <% if (isNew) { %><p class="lead" style="margin:16px auto 0">Lunar Lucky sẽ gọi xác nhận trong giờ làm việc. <%= order.email ? 'Thông tin đơn đã được gửi đến ' + order.email + '.' : '' %></p><% } %>
    <div class="order-code">Mã đơn: <span data-copy-text><%= order.code %></span>
      <button type="button" class="copy-btn" data-copy="<%= order.code %>"><svg class="icon icon-sm"><use href="#i-copy"/></svg> Sao chép</button>
    </div>
  </div>

  <% if (needPay && qr) { %>
  <section class="qr-card" aria-labelledby="pay-title">
    <img src="<%= qr %>" alt="Mã VietQR chuyển khoản <%= money(order.total) %> cho đơn <%= order.code %>" width="260" height="300">
    <div>
      <h2 id="pay-title" class="h3">Quét mã để thanh toán</h2>
      <p class="muted small" style="margin:6px 0 16px">Mở ứng dụng ngân hàng, quét mã QR. Số tiền và nội dung đã được điền sẵn.</p>
      <% if (order.needs_vat) { %><div class="flash flash-info" style="margin:0 0 12px"><svg class="icon"><use href="#i-file"/></svg><span>Đơn xuất hóa đơn VAT: vui lòng chuyển khoản vào <b>tài khoản công ty</b> bên dưới<%= s.company_name ? ' (' + s.company_name + ')' : '' %>. Hóa đơn sẽ gửi về <b><%= order.vat_email %></b>.</span></div><% } %>
      <div class="bank-rows">
        <div class="bank-row"><span>Ngân hàng</span><b><%= payee.bankName || payee.bankId %></b></div>
        <div class="bank-row"><span>Số tài khoản</span><span style="display:flex;gap:8px;align-items:center"><b><%= payee.account %></b><button type="button" class="copy-btn" data-copy="<%= payee.account %>" aria-label="Sao chép số tài khoản"><svg class="icon icon-sm"><use href="#i-copy"/></svg></button></span></div>
        <div class="bank-row"><span>Chủ tài khoản</span><b><%= payee.holder %></b></div>
        <div class="bank-row"><span>Số tiền</span><span style="display:flex;gap:8px;align-items:center"><b style="color:var(--lacquer-700)"><%= money(order.total) %></b><button type="button" class="copy-btn" data-copy="<%= order.total %>" aria-label="Sao chép số tiền"><svg class="icon icon-sm"><use href="#i-copy"/></svg></button></span></div>
        <div class="bank-row"><span>Nội dung</span><span style="display:flex;gap:8px;align-items:center"><b><%= order.code %></b><button type="button" class="copy-btn" data-copy="<%= order.code %>" aria-label="Sao chép nội dung chuyển khoản"><svg class="icon icon-sm"><use href="#i-copy"/></svg></button></span></div>
      </div>
      <p class="small muted" style="margin-top:12px">Vui lòng giữ nguyên nội dung <b><%= order.code %></b> để Lunar Lucky đối soát nhanh.</p>
    </div>
  </section>
  <% } else if (needPay && order.needs_vat) { %>
  <section class="card" style="border-color:var(--gold-500)">
    <h2 class="h3">Thông tin chuyển khoản sẽ được gửi riêng</h2>
    <p class="muted" style="margin-top:8px">Đơn xuất hóa đơn VAT được thanh toán vào tài khoản công ty. Lunar Lucky sẽ liên hệ qua số <b><%= order.phone %></b> hoặc email <b><%= order.vat_email %></b> để gửi thông tin chuyển khoản trong giờ làm việc.</p>
  </section>
  <% } %>

  <% if (!cancelled) { %>
  <section class="card" style="margin-top:24px" aria-label="Trạng thái đơn hàng">
    <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;align-items:center">
      <h2 class="h3">Trạng thái</h2>
      <span class="status status-<%= order.payment_status %>"><%= order.payment_method === 'cod' ? 'COD · ' : 'Chuyển khoản · ' %><%= { pending: 'Chưa thanh toán', paid: 'Đã thanh toán', refunded: 'Đã hoàn tiền' }[order.payment_status] %></span>
    </div>
    <ol class="timeline">
      <% steps.forEach((st, i) => { %><li class="<%= i <= idx ? 'done' : '' %>" <%- i === idx ? 'aria-current="step"' : '' %>><%= st[1] %></li><% }) %>
    </ol>
  </section>
  <% } %>

  <div class="split" style="margin-top:24px;gap:24px;align-items:start">
    <section class="card">
      <h2 class="h3" style="margin-bottom:16px">Giao hàng</h2>
      <dl class="kv">
        <dt>Người đặt</dt><dd><%= order.customer_name %> · <%= order.phone %></dd>
        <% if (order.is_gift) { %>
          <dt>Người nhận</dt><dd><%= order.recipient_name %> · <%= order.recipient_phone %></dd>
          <dt>Địa chỉ</dt><dd><%= order.recipient_address %>, <%= order.province %></dd>
        <% } else { %>
          <dt>Địa chỉ</dt><dd><%= order.address %>, <%= order.province %></dd>
        <% } %>
        <dt>Ngày giao</dt><dd><%= fmt.ymd(order.delivery_date) %></dd>
        <% if (order.needs_vat) { %><dt>Hóa đơn VAT</dt><dd><%= order.vat_company %><br><span class="small muted">MST <%= order.vat_tax_code %> · gửi về <%= order.vat_email %></span></dd><% } %>
        <% if (order.card_message) { %><dt>Thiệp</dt><dd class="serif" style="font-size:19px;font-style:italic">“<%= order.card_message %>”</dd><% } %>
        <% if (order.note) { %><dt>Ghi chú</dt><dd><%= order.note %></dd><% } %>
      </dl>
    </section>
    <section class="card">
      <h2 class="h3" style="margin-bottom:16px">Sản phẩm</h2>
      <ul class="summary-items" style="grid-template-columns:1fr">
        <% items.forEach(i => { %>
          <li style="grid-template-columns:1fr auto"><span><%= i.name %> × <%= i.qty %></span><span class="line-total"><%= money(i.line_total) %></span></li>
        <% }) %>
      </ul>
      <div class="sum-row"><span>Tạm tính</span><span><%= money(order.subtotal) %></span></div>
      <% if (order.discount) { %><div class="sum-row"><span>Giảm giá (<%= order.coupon_code %>)</span><span class="disc">−<%= money(order.discount) %></span></div><% } %>
      <div class="sum-row"><span>Phí giao hàng</span><span><%= order.shipping_fee ? money(order.shipping_fee) : 'Miễn phí' %></span></div>
      <% if (order.vat_fee) { %><div class="sum-row"><span>Phí xuất hóa đơn VAT<%= order.vat_fee_percent ? ' (' + Number(order.vat_fee_percent) + '%)' : '' %></span><span><%= money(order.vat_fee) %></span></div><% } %>
      <div class="sum-row total"><span>Tổng cộng</span><span><%= money(order.total) %></span></div>
    </section>
  </div>

  <div class="hero-cta" style="justify-content:center;margin-block:48px 96px">
    <a class="btn btn-quiet" href="/bo-suu-tap">Tiếp tục mua sắm</a>
    <a class="btn btn-quiet" href="<%= s.zalo_url %>" target="_blank" rel="noopener">Cần hỗ trợ? Nhắn Zalo</a>
  </div>
</div>
<%- include('../partials/bottom') %>
