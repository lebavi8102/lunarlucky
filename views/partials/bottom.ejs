    <a class="support-item" role="menuitem" href="tel:<%= s.shop_phone.replace(/\s/g, '') %>"><svg class="icon icon-sm"><use href="#i-phone"/></svg> Gọi điện</a>
  </div>
  <button type="button" class="support-toggle" data-support-toggle aria-haspopup="menu" aria-expanded="false"><svg class="icon icon-sm"><use href="#i-chat"/></svg> <%= aiReady ? 'Chat với trợ lý AI' : 'Hỗ trợ' %></button>
</div>

