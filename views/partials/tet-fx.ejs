<%# Linh vật Tết 2027 — Dê Mùi Lộc. Bật/tắt: Cài đặt → Hiệu ứng Tết %>
<div class="tet-mascot no-print" data-tet-mascot data-lines="Chúc mừng năm mới Đinh Mùi 2027! 🧧|Cần chọn quà Tết? Bấm vào em nhé!|Quà doanh nghiệp: in logo, xuất VAT ✨|Đặt sớm để chọn ngày giao đẹp 🌸">
  <div class="tet-bubble" data-tet-bubble role="status" aria-live="polite"></div>
  <% if (aiReady) { %>
  <button type="button" class="tet-mascot-btn" data-ai-start aria-label="Linh vật Mùi Lộc – mở tư vấn chọn quà">
  <% } else { %>
  <a class="tet-mascot-btn" href="<%= s.zalo_url %>" target="_blank" rel="noopener" aria-label="Linh vật Mùi Lộc – nhắn Zalo tư vấn">
  <% } %>
    <img src="/img/tet/goat.webp" alt="" width="208" height="208">
  <% if (aiReady) { %></button><% } else { %></a><% } %>
  <button type="button" class="tet-close" data-tet-close aria-label="Ẩn linh vật">×</button>
</div>
