<%# Ảnh khách đã nhận quà. Tham số: reviews (mảng), heading (tùy chọn) %>
<% if (reviews && reviews.length) { %>
<div class="review-grid">
  <% reviews.forEach(r => { %>
  <figure class="review-card">
    <img src="<%= img(r.image_id) %>" alt="Lunar Lucky giao quà cho <%= r.customer_name %>" loading="lazy" width="400" height="500">
    <figcaption>
      <% if (r.content) { %><blockquote>“<%= r.content %>”</blockquote><% } %>
      <span class="small muted">— <%= r.customer_name %></span>
    </figcaption>
  </figure>
  <% }) %>
</div>
<% } %>
