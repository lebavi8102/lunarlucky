# ==== Lunar — biến môi trường ====
# Trên Hostinger: nhập các biến này trong hPanel > Websites > Node.js > Environment variables
NODE_ENV=production
PORT=3000
SITE_URL=https://lunar.vn

# Chuỗi ngẫu nhiên dài ≥ 32 ký tự (tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# MySQL (hPanel > Databases > MySQL Databases)
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Tài khoản quản trị tạo khi chạy "npm run seed" (đổi mật khẩu sau khi đăng nhập lần đầu)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (SMTP của Hostinger: smtp.hostinger.com, cổng 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lunar <hello@lunar.vn>"

# Telegram: tạo bot qua @BotFather, lấy chat id qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
